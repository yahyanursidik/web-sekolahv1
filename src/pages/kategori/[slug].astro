---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const articles = await getCollection('artikel');
  // Extract unique categories
  const categories = [...new Set(articles.map((a) => a.data.category).filter(Boolean))];
  
  return categories.map((cat) => {
    // Return paths for each category, passing the articles of that category as props
    return { 
      params: { slug: cat.toLowerCase().replace(/\s+/g, '-') }, 
      props: { 
        categoryName: cat,
        articles: articles.filter((a) => a.data.category === cat) 
      } 
    };
  });
}

const { categoryName, articles } = Astro.props;
if (!categoryName) return Astro.redirect('/404');
---

<Layout title={`Kategori: ${categoryName}`}>
    <main class="pt-32 pb-section-padding-desktop">
        <div class="max-w-container-max mx-auto px-gutter">
            <header class="text-center mb-12">
                <h1 class="font-headline-lg text-4xl text-primary mb-4">Kategori: {categoryName}</h1>
                <p class="text-on-surface-variant">Kumpulan artikel untuk kategori ini.</p>
            </header>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {articles.map((article) => (
                <article class="bg-surface-container-lowest rounded-lg overflow-hidden border border-outline-variant hover:border-primary transition-colors">
                    <div class="h-48 bg-surface-dim overflow-hidden">
                        <img src={article.data.thumbnail || "https://lh3.googleusercontent.com/aida-public/AB6AXuDmzkKM5stq1ZOeNzj6zclPCLA2xIR-a8rQ9ZrvdaJImDMn4efVivn9TwZC-dB2fFguFNq8cChWSjDuuAdOLvQNR9mPhs2uncFo7AexvDPVnnOYJPrbx7NqI4-vjeTzHl__wk736cddSZF30IfaCCo5WT7qGdCZeU8VtA7MM1ykzS-pNVIkat7h1pGlzQq-fWgLJ_iT_jbX02qTEVlE8Yowjub3AujRftd4XbHjUZEOQEtKLZ43WfY19p6EaypSnAlWfhpmpNRcwCY"} alt={article.data.title} class="w-full h-full object-cover" />
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-xl mb-3 text-primary">{article.data.title}</h3>
                        <p class="text-on-surface-variant text-sm mb-4">{article.data.date}</p>
                        <a href={`/artikel/${article.id}`} class="text-primary font-bold hover:underline">Baca Selengkapnya</a>
                    </div>
                </article>
                ))}
            </div>
            
            <div class="mt-12 text-center">
                <a href="/artikel" class="text-secondary font-bold hover:underline">Kembali ke Semua Artikel</a>
            </div>
        </div>
    </main>
</Layout>
