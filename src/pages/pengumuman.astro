---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const announcements = await getCollection('pengumuman');
---
<Layout title="Pengumuman">

<!-- Hero Section -->
<section class="relative pt-32 pb-20 overflow-hidden bg-surface-container-low wood-texture">
  <div class="absolute inset-0 pattern-bg z-0 opacity-50"></div>
  <div class="container mx-auto px-gutter relative z-10 text-center">
    <h1 class="font-display-lg text-display-lg text-primary mb-6">Pengumuman Sekolah</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
      Pusat informasi terbaru dan pengumuman resmi dari Tarbiyah Sunnah Lab School.
    </p>
  </div>
</section>

<!-- Content -->
<section class="py-section-padding-desktop bg-background min-h-[50vh]">
  <div class="container mx-auto px-gutter">
    <div class="max-w-4xl mx-auto space-y-6">
      
{announcements.map((item) => (
<div class="bg-surface-container-lowest rounded-xl p-6 border border-outline-variant/30 hover-lift reveal-up active">
    <div class="flex items-center gap-3 mb-3">
        <span class="inline-block px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed-variant text-xs font-bold uppercase tracking-wider">{item.data.kategori || 'Umum'}</span>
        <time class="text-on-surface-variant text-sm font-medium">{item.data.date}</time>
    </div>
    <h3 class="font-headline-sm text-xl text-primary mb-3">{item.data.title}</h3>
</div>
))}

    </div>
  </div>
</section>

</Layout>
