---
import Layout from '../layouts/Layout.astro';
import globalSettings from '../content/settings/global.json';
---
<Layout title="Kontak dan Lokasi | TS Lab School" description="Hubungi School Center dan temukan lokasi Tarbiyah Sunnah Lab School di Bandung.">

<!-- Hero Section -->
<section class="relative pt-32 pb-20 overflow-hidden bg-surface-container-low wood-texture">
  <div class="absolute inset-0 pattern-bg z-0 opacity-50"></div>
  <div class="container mx-auto px-gutter relative z-10 text-center">
    <h1 class="font-display-lg text-display-lg text-primary mb-6">Hubungi Kami</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
      Kami siap menjawab pertanyaan Anda seputar program, pendaftaran, maupun jadwal kunjungan ke Tarbiyah Sunnah Lab School.
    </p>
  </div>
</section>

<!-- Contact Info -->
<section class="py-section-padding-desktop bg-background">
  <div class="container mx-auto px-gutter">
    <div class="grid lg:grid-cols-2 gap-12">
      <div class="space-y-8">
        <div>
          <h2 class="font-headline-md text-headline-md text-primary mb-6">Informasi Kontak</h2>
          <p class="text-on-surface-variant mb-8">
            Silakan hubungi kami melalui saluran berikut untuk informasi lebih lanjut mengenai pendaftaran dan program pendidikan kami.
          </p>
        </div>
        
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="bg-primary/10 p-3 rounded-lg text-primary mt-1">
              <span class="material-symbols-outlined" data-icon="location_on">location_on</span>
            </div>
            <div>
              <h4 class="font-bold text-lg mb-1">Alamat</h4>
              <p class="text-on-surface-variant">
                Jl. Setrasari VI No.3A, Sukarasa<br />
                Kec. Sukasari, Kota Bandung<br />
                Jawa Barat 40152
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="bg-primary/10 p-3 rounded-lg text-primary mt-1">
              <span class="material-symbols-outlined" data-icon="phone">phone</span>
            </div>
            <div>
              <h4 class="font-bold text-lg mb-1">WhatsApp (School Center)</h4>
              <p class="text-on-surface-variant">
                <a href="https://wa.me/6285173396002" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">+62 851-7339-6002</a>
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="bg-primary/10 p-3 rounded-lg text-primary mt-1">
              <span class="material-symbols-outlined" data-icon="email">email</span>
            </div>
            <div>
              <h4 class="font-bold text-lg mb-1">Email</h4>
              <p class="text-on-surface-variant">
                <a href="mailto:salam@tslabschool.id" class="hover:text-primary transition-colors">salam@tslabschool.id</a>
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="bg-surface-container rounded-lg p-2 border border-outline-variant shadow-sm h-full min-h-[400px] flex items-center justify-center overflow-hidden relative">
        {globalSettings.mapsUrl && globalSettings.mapsUrl.trim() !== '' ? (
          <iframe 
            src={globalSettings.mapsUrl} 
            width="100%" 
            height="100%" 
            style="border:0; position: absolute; top:0; left:0; width:100%; height:100%;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        ) : (
          <div class="text-center p-8">
            <span class="material-symbols-outlined text-6xl text-primary mb-4 block" data-icon="map">map</span>
            <p class="text-on-surface-variant">Peta lokasi (Google Maps Embed) dapat ditambahkan melalui pengaturan website.</p>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

</Layout>
