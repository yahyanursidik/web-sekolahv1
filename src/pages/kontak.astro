---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import { EXTERNAL_LINKS, SITE } from '../data/constants';
import globalSettings from '../content/settings/global.json';
---

<Layout
  title={`Kontak | ${SITE.name}`}
  description={`Hubungi School Center ${SITE.name} di ${SITE.city} untuk informasi program, SPMB, dan kunjungan.`}
>
  <PageHero
    eyebrow="Terhubung dengan kami"
    title="Kami senang membantu<br />Abba & Umma mengenal sekolah."
    intro="Tanyakan program, penerimaan, atau informasi kunjungan melalui kanal resmi School Center."
    crumbs={[{ href: '/', label: 'Beranda' }, { label: 'Kontak' }]}
  />

  <section class="section--tight">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-card">
          <span class="eyebrow">School Center</span>
          <h3>Konsultasi & informasi SPMB</h3>
          <p>
            WhatsApp: {SITE.phone}<br />
            Jam layanan mengikuti ketentuan sekolah pada hari kerja.
          </p>
          <a class="btn btn--primary" href={EXTERNAL_LINKS.consultation} target="_blank" rel="noopener">
            Chat School Center ↗
          </a>
        </div>

        <div class="contact-card">
          <span class="eyebrow">Lokasi sekolah</span>
          <h3>{SITE.city}</h3>
          <p>{SITE.address}</p>
          <a class="btn btn--light" href={EXTERNAL_LINKS.maps} target="_blank" rel="noopener">
            Buka Peta ↗
          </a>
        </div>

        <div class="contact-card">
          <span class="eyebrow">Portal orang tua</span>
          <h3>Portal Orang Tua</h3>
          <p>
            Khusus wali murid aktif untuk memantau perkembangan Ananda dan informasi sekolah.
            Pendaftaran murid baru menggunakan tautan SPMB yang terpisah.
          </p>
          <a class="btn btn--light" href={EXTERNAL_LINKS.portal} target="_blank" rel="noopener">
            Buka Portal Orang Tua ↗
          </a>
        </div>

        <div class="contact-card">
          <span class="eyebrow">Kunjungan sekolah</span>
          <h3>Ingin melihat langsung?</h3>
          <p>
            Jadwal kunjungan diatur agar tidak mengganggu kegiatan belajar. Ajukan permintaan melalui
            School Center terlebih dahulu.
          </p>
          <a class="btn btn--light" href={EXTERNAL_LINKS.consultation} target="_blank" rel="noopener">
            Ajukan Kunjungan ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight section--tint">
    <div class="container">
      <SectionHead
        eyebrow="Peta lokasi"
        title="Menemukan sekolah kami di Bandung."
        desc="Jl. Setrasari VI No.3A, Sukarasa, Kecamatan Sukasari, Kota Bandung."
      />
      <div class="contact-map">
        <iframe
          src={globalSettings.mapsUrl}
          title={`Peta lokasi ${SITE.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
