---
import Layout from '../../layouts/Layout.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import FaqAccordion from '../../components/ui/FaqAccordion.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import ProgramCard from '../../components/ui/ProgramCard.astro';
import { PROGRAMS, PILLAR_INK } from '../../data/programs';
import { EXTERNAL_LINKS, SITE, SPMB } from '../../data/constants';

// Pengaman: bila output diubah ke "server", tanpa baris ini Astro mengabaikan
// getStaticPaths() dan halaman dirender tanpa props sehingga tampil kosong.
export const prerender = true;

export function getStaticPaths() {
  return PROGRAMS.map((program) => ({ params: { slug: program.slug }, props: { program } }));
}

const { program } = Astro.props;
const others = PROGRAMS.filter((item) => item.slug !== program.slug);
---

<Layout
  title={`${program.name} | ${SITE.name}`}
  description={program.summary}
  image={program.heroImage ?? '/images/elementary-kelas-1.jpg'}
>
  {/* 1–4 · Breadcrumb, label satuan, headline, deskripsi, foto */}
  <section class="page-hero page-hero--tint">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span aria-hidden="true">/</span>
        <a href="/program">Program</a>
        <span aria-hidden="true">/</span>
        <span>{program.name}</span>
      </nav>

      <div class="detail-hero">
        <div>
          <span class="eyebrow">{program.tag}</span>
          <h1 class="page-title">{program.heroTitle}</h1>
          <p class="page-intro">{program.summary}</p>

          <div class="hero__actions">
            <a class="btn btn--primary" href="/spmb">
              Info Pendaftaran <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
            <a
              class="btn btn--light"
              href={EXTERNAL_LINKS.consultation}
              target="_blank"
              rel="noopener"
            >
              Tanya School Center
            </a>
          </div>

          <div class="detail-metrics">
            <div>{program.ageRange}</div>
            <div>{program.modality}</div>
            <div>{program.learningModel}</div>
          </div>
        </div>

        <div class="detail-image">
          {
            program.heroImage && (
              <img src={program.heroImage} alt={program.imageAlt} width="760" height="760" />
            )
          }
          <span class="detail-image__label">{program.imageCaption}</span>
        </div>
      </div>
    </div>
  </section>

  {/* 5 · Tiga kartu MOVE / LEARN / GROW */}
  <section class="detail-section">
    <div class="container">
      <SectionHead
        eyebrow="Move · Learn · Grow"
        title={`Pengalaman belajar di ${program.name}.`}
        desc="Setiap pilar diterjemahkan menjadi aktivitas dan pendampingan yang sesuai tahap perkembangan."
      />
      <div class="content-grid">
        {
          program.pillars.map((pillar) => (
            <article class="info-card">
              <span class="info-card__id" style={`color:${PILLAR_INK[pillar.key]}`}>
                {pillar.label}
              </span>
              <h3>{pillar.title}</h3>
              <p>{pillar.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 6 · Alur pengalaman belajar */}
  <section class="section--tight section--tint">
    <div class="container">
      <SectionHead
        eyebrow="Bagaimana prosesnya"
        title="Contoh alur pengalaman belajar."
        desc="Cara guru dan keluarga memberikan pengalaman belajar yang bermakna."
      />
      <div class="steps">
        {
          program.journey.map((step, index) => (
            <article class="step">
              <b>{String(index + 1).padStart(2, '0')}</b>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 5b · Pendalaman konten unit */}
  {
    program.deepDive.map((block) => (
      <section class:list={['detail-section', { 'section--tint': block.tint }]}>
        <div class="container">
          <SectionHead eyebrow={block.eyebrow} title={block.title} desc={block.lead} />
          <div
            class:list={[
              'content-grid',
              { 'content-grid--2': block.columns === 2, 'content-grid--4': block.columns === 4 },
            ]}
          >
            {block.items.map((item) => (
              <article class="info-card">
                {item.id && <span class="info-card__id">{item.id}</span>}
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
                {item.example && <p class="info-card__example">{item.example}</p>}
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  {/* 6b · Ritme harian / pekanan */}
  <section class="detail-section">
    <div class="container">
      <SectionHead
        eyebrow="Ritme belajar"
        title={program.rhythmTitle}
        desc="Ritme yang teratur memberi rasa aman dan membantu Ananda memprediksi aktivitas berikutnya."
      />
      <div class="rhythm">
        {
          program.rhythm.map((row) => (
            <div class="rhythm__row">
              <span class="rhythm__time">{row.time}</span>
              <div class="rhythm__body">
                <h3>{row.title}</h3>
                <p>{row.desc}</p>
              </div>
              <span class="rhythm__tag">{row.tag}</span>
            </div>
          ))
        }
      </div>
      <div class="notice">{program.rhythmNote}</div>
    </div>
  </section>

  {/* 7 · Pendampingan guru & keluarga */}
  <section class="section--tight section--tint">
    <div class="container">
      <SectionHead
        eyebrow="Pendampingan"
        title={program.supportTitle}
        desc={program.supportLead}
      />
      <div class:list={['content-grid', { 'content-grid--2': program.support.length <= 2 }]}>
        {
          program.support.map((item, index) => (
            <article class="info-card">
              <span class="info-card__id">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 8 · FAQ unit */}
  <section class="detail-section">
    <div class="container">
      <SectionHead
        eyebrow="Tanya jawab"
        title={`Pertanyaan umum tentang ${program.name}.`}
        linkHref="/faq"
        linkLabel="Lihat semua FAQ"
      />
      <FaqAccordion items={program.faq} />
      <div class="notice" style="max-width:820px;margin-inline:auto">
        {program.needsValidation}
      </div>
    </div>
  </section>

  {/* Program lain */}
  <section class="section--tight section--tint">
    <div class="container">
      <SectionHead
        eyebrow="Pilihan lain"
        title="Bandingkan dengan program lain."
        linkHref="/program"
        linkLabel="Semua program"
      />
      <div class="program-grid" style="grid-template-columns:repeat(2,minmax(0,1fr))">
        {others.map((item) => <ProgramCard program={item} />)}
      </div>
    </div>
  </section>

  {/* 9 · CTA */}
  <CtaBand
    title={`Mengenal lebih dekat ${program.name}?`}
    desc={`Tanyakan kesesuaian program dengan kebutuhan Ananda, atau lanjutkan ke informasi ${SPMB.label}.`}
  />
</Layout>
