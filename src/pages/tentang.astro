---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { SITE } from '../data/constants';

const missions = [
  {
    id: '01 · AQIDAH & MANHAJ',
    title: "Internalisasi Al-Qur'an & As-Sunnah",
    desc: "Menginternalisasi nilai-nilai Al-Qur'an dan As-Sunnah sesuai pemahaman Salafus Shalih dalam kehidupan sehari-hari.",
  },
  {
    id: '02 · MAHABBATUL ILMI',
    title: "Kecintaan terhadap ilmu & Al-Qur'an",
    desc: "Menumbuhkan rasa cinta terhadap ilmu agama, Al-Qur'an, dan semangat istiqamah dalam menuntut ilmu syar'i.",
  },
  {
    id: '03 · FITRAH',
    title: 'Merawat & menjaga fitrah anak',
    desc: 'Merawat, menumbuhkan, dan menjaga fitrah anak agar senantiasa lurus, suci, dan berkembang optimal.',
  },
  {
    id: '04 · RAMAH ANAK',
    title: 'Pendidikan ramah & menghargai keunikan',
    desc: 'Menyelenggarakan pendidikan ramah anak yang menghargai keunikan potensi dan tahapan perkembangan setiap individu.',
  },
  {
    id: '05 · MUTU & ADAB',
    title: 'Lembaga bermutu & berakhlakul karimah',
    desc: 'Menyelenggarakan lembaga pendidikan yang bermutu, unggul secara tata kelola, dan berlandaskan akhlakul karimah.',
  },
  {
    id: '06 · LIFE SKILLS',
    title: 'Kompetensi akademik & life skills adaptif',
    desc: 'Mengembangkan kompetensi akademik, daya nalar kritis, dan keterampilan hidup yang adaptif terhadap tantangan zaman.',
  },
];

const leadership = [
  {
    role: 'Dewan Pembina Yayasan',
    name: 'Ustadz Abu Haidar As-Sundawy',
    desc: 'حَفِظَهُ اللهُ تَعَالَى · Pembina Yayasan Tarbiyah Sunnah.',
  },
  {
    role: 'Ketua Yayasan',
    name: 'Asep Dadang Sukarna Hikmat Nirwana',
    desc: 'Memimpin arah strategis, legalitas, dan tata kelola kelembagaan Yayasan Tarbiyah Sunnah.',
  },
  {
    role: 'Ketua Bidang Pendidikan Yayasan',
    name: 'Mochammad Hilman Al-Fiqhy, M.A.',
    desc: "Mengawal standardisasi kurikulum syar'i, mutu akademik, dan pembinaan guru di bawah yayasan.",
  },
  {
    role: 'PLT Kepala Unit',
    name: 'Yahya Nursidik, S.Pd., M.T.',
    desc: 'Kepemimpinan unit Sekolah Tarbiyah Sunnah Bandung.',
  },
  {
    role: 'Wakasek SD',
    name: 'Resania Novita, S.Pd.',
    desc: 'Manajemen operasional pembelajaran, kurikulum, dan ketertiban adab jenjang SD.',
  },
  {
    role: 'Wakasek TK',
    name: 'Lia Amalia',
    desc: 'Manajemen sentra bermain ramah fitrah, pendampingan orang tua, dan program usia dini.',
  },
];
---

<Layout
  title={`Tentang | ${SITE.name}`}
  description="Sekolah Tarbiyah Sunnah Bandung — sekolah Islam di Bandung yang merawat fitrah dan membangun generasi berkarakter Rabbani."
>
  <PageHero
    eyebrow="Tentang Sekolah Tarbiyah Sunnah Bandung"
    title="Pendidikan yang menghargai fitrah.<br />Berorientasi pada karakter Rabbani."
    intro={SITE.description}
    crumbs={[{ href: '/', label: 'Beranda' }, { label: 'Tentang' }]}
  />

  <section class="section--tight">
    <div class="container">
      <div class="approach-row">
        <div>
          <span class="eyebrow">Arah yang kami tuju</span>
          <h2>Membangun Generasi Berkarakter Rabbani.</h2>
          <p>
            Visi ini menjadi kompas dalam setiap kurikulum dan aktivitas: memastikan anak tidak hanya
            tumbuh cerdas secara intelektual, tetapi juga kokoh dalam ketauhidan, adab, dan
            kemandirian.
          </p>
          <div style="margin-top:25px">
            <a class="btn btn--primary" href="/pendekatan">
              Kenali Cara Belajar <span class="btn__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="approach-panel">
          <strong style="font-size:37px;line-height:1.3">Fitrah.<br />Iman.<br />Adab.<br />Ilmu.</strong>
          <p>
            Empat kata yang mewarnai pendidikan tanpa menyederhanakan tujuan menjadi sekadar capaian
            akademik.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight section--tint">
    <div class="container">
      <SectionHead
        eyebrow="Langkah strategis"
        title="Enam misi sekolah."
        desc="Komitmen institusi dalam mewujudkan pendidikan Islam yang ramah anak, berakar pada sunnah, dan berdaya menghadapi masa depan."
      />
      <div class="content-grid">
        {
          missions.map((mission) => (
            <article class="info-card">
              <span class="info-card__id">{mission.id}</span>
              <h3>{mission.title}</h3>
              <p>{mission.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <SectionHead
        eyebrow="Tata kelola & amanah"
        title="Struktur & kepemimpinan."
        desc="Sinergi kepemimpinan dan bimbingan guru dalam mengawal visi pendidikan Rabbani di sekolah kami."
      />
      <div class="content-grid">
        {
          leadership.map((person) => (
            <article class="info-card">
              <span class="info-card__id">{person.role.toUpperCase()}</span>
              <h3>{person.name}</h3>
              <p>{person.desc}</p>
            </article>
          ))
        }
      </div>
      <div class="notice">
        Redaksi resmi visi, misi, nama satuan pendidikan, dan susunan kepemimpinan mengikuti dokumen
        yayasan terkini. Perbarui halaman ini setiap kali terjadi perubahan struktur.
      </div>
    </div>
  </section>

  <CtaBand
    title="Bergabung bersama keluarga besar Sekolah Tarbiyah Sunnah Bandung"
    desc="Kenali jenjang yang sesuai untuk Ananda, lalu lanjutkan pendaftaran melalui portal resmi TSLS Hub."
  />
</Layout>
