---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
import { cn } from '../lib/utils';
import { EXTERNAL_LINKS } from '../data/constants';
import PreschoolLoop from '../components/diagrams/PreschoolLoop.astro';
import PreschoolHeroIllustration from '../components/illustrations/PreschoolHeroIllustration.astro';
---

<Layout title="Preschool Onsite | Tarbiyah Sunnah Lab School">

  {/* =========================================================================
      Hero Section (Natural Islamic Academic for Preschool)
     ========================================================================= */}
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-tsls-cream-50 overflow-hidden border-b border-tsls-olive-950/10">
    
    {/* Subtle Arabic Watermark Background */}
    <div class="absolute right-0 top-1/3 -translate-y-1/2 opacity-[0.03] pointer-events-none select-none z-0">
      <span class="arabic-watermark text-[140px] md:text-[240px] font-normal leading-none text-tsls-olive-950" dir="rtl">
        رَوْضَةُ الأَطْفَال
      </span>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        
        {/* Hero Copy */}
        <div class="lg:col-span-7 space-y-8" data-reveal>
          
          <div class="flex flex-wrap items-center gap-3">
            <span class="academic-stamp text-tsls-olive-800 bg-tsls-sage-500/20 px-3 py-1 border border-tsls-sage-500/40">
              TSLS PRESCHOOL · ONSITE (USIA 3–6 TAHUN)
            </span>
            <span class="text-xs font-mono text-tsls-wood-600 font-bold">
              BANDUNG
            </span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-tsls-olive-950 leading-[1.12] tracking-tight text-balance">
            Merawat Fitrah Sejak Awal Kehidupan.
          </h1>

          <p class="text-base sm:text-lg text-tsls-olive-950/80 max-w-xl leading-relaxed text-pretty">
            Pendidikan anak usia dini berbasis fitrah yang mendampingi ananda melalui bermain bermakna, eksplorasi bahan alam, pembiasaan adab salaf, dan lingkungan belajar hangat yang aman dari tekanan kognitif berlebihan.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <a href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ size: 'lg' }), 'bg-tsls-olive-950 text-tsls-cream-50 hover:bg-tsls-olive-800 font-bold px-8 rounded-none shadow-sm')}>
              Daftar SPMB Preschool (TSLS Hub) &rarr;
            </a>
            <a href="/kontak" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'border-tsls-olive-950 text-tsls-olive-950 hover:bg-tsls-olive-950 hover:text-tsls-cream-50 font-bold px-8 rounded-none transition-colors')}>
              Jadwalkan Kunjungan
            </a>
          </div>

          {/* Key Preschool Onsite Metrics */}
          <div class="pt-8 border-t border-tsls-olive-950/10 grid grid-cols-3 gap-4 text-left">
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Rasio Guru & Murid</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">1 : 6 (Intensif & Hangat)</div>
            </div>
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Metode Belajar</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">Sentra & Eksplorasi Alam</div>
            </div>
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Fondasi Utama</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">Tauhid, Adab & Self-Care</div>
            </div>
          </div>

        </div>

        {/* Hero Photo / Authentic Preschool Outdoor Environment */}
        <div class="lg:col-span-5" data-reveal="fade-up">
          <div class="relative p-3 bg-tsls-cream-100 border border-tsls-olive-950/20 shadow-md">
            <div class="relative aspect-[4/5] sm:aspect-[4/3] lg:aspect-[3/4] overflow-hidden bg-tsls-cream-200 group">
              <img 
                src="/images/preschool-outdoor.jpg" 
                alt="Area Bermain Outdoor & Motorik Kasar Preschool Tarbiyah Sunnah Lab School" 
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="eager"
              />
              
              {/* Subtle Top Badge */}
              <div class="absolute top-3 left-3 z-10">
                <span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-bold tracking-wider uppercase px-2.5 py-1 bg-tsls-olive-950/90 text-tsls-cream-50 backdrop-blur-sm border border-tsls-sand-400/40">
                  <span class="w-1.5 h-1.5 rounded-full bg-tsls-sand-400 animate-pulse"></span>
                  AREA OUTDOOR & MOTORIK
                </span>
              </div>

              {/* Bottom Editorial Caption */}
              <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-tsls-olive-950/90 via-tsls-olive-950/60 to-transparent p-4 sm:p-5 text-tsls-cream-50">
                <span class="text-[10px] font-mono tracking-widest uppercase text-tsls-sand-400 block font-bold">Ruang Belajar Ramah Fitrah</span>
                <p class="text-xs font-serif italic text-tsls-cream-100 mt-0.5 leading-relaxed">
                  Ruang gerak bebas motorik, stimulasi sensorik alami, dan udara terbuka yang aman dan menyenangkan untuk ananda.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* =========================================================================
      Section 1 — Filosofi Usia Dini: Bukan Perlombaan Kognitif
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8" data-reveal>
      
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
        PRINSIP USIA DINI
      </div>

      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
        Masa Usia Dini Bukan Perlombaan Kognitif
      </h2>

      <p class="text-base sm:text-lg text-tsls-olive-950/85 leading-relaxed text-pretty max-w-3xl mx-auto">
        Di TSLS, anak usia 3–6 tahun tidak diperlakukan sebagai murid SD versi kecil yang dipaksa duduk diam berjam-jam mengerjakan lembar kerja (*worksheet*). 
      </p>

      <div class="grid sm:grid-cols-3 gap-6 pt-4 text-left">
        <div class="p-6 bg-tsls-cream-50 border border-tsls-olive-950/15">
          <div class="text-xs font-mono font-bold text-tsls-wood-600 mb-2">01 / FITRAH</div>
          <h4 class="font-display font-bold text-base text-tsls-olive-950 mb-1">Menjaga Kesenangan Belajar</h4>
          <p class="text-xs text-tsls-olive-950/75 leading-relaxed">Menumbuhkan kecintaan alami pada ilmu, bukan rasa jenuh akibat paksaan calistung instan.</p>
        </div>

        <div class="p-6 bg-tsls-cream-50 border border-tsls-olive-950/15">
          <div class="text-xs font-mono font-bold text-tsls-wood-600 mb-2">02 / SENSORIK</div>
          <h4 class="font-display font-bold text-base text-tsls-olive-950 mb-1">Pengalaman Konkret</h4>
          <p class="text-xs text-tsls-olive-950/75 leading-relaxed">Anak belajar dengan menyentuh, meraba, mencium, bergerak, dan mengamati objek nyata di sekitarnya.</p>
        </div>

        <div class="p-6 bg-tsls-cream-50 border border-tsls-olive-950/15">
          <div class="text-xs font-mono font-bold text-tsls-wood-600 mb-2">03 / ADAB</div>
          <h4 class="font-display font-bold text-base text-tsls-olive-950 mb-1">Pembiasaan Kasih Sayang</h4>
          <p class="text-xs text-tsls-olive-950/75 leading-relaxed">Menanamkan keteladanan doa, dzikir, makan beradab, dan empati melalui relasi yang hangat.</p>
        </div>
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 2 — Diagram Siklus Belajar Preschool (Preschool Learning Loop)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          METODOLOGI PENGALAMAN KONKRET
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Bagaimana Anak Usia Dini Belajar?
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Anak tidak belajar dari ceramah teoritis. Pembelajaran di Preschool TSLS mengalir melalui siklus pengalaman alami yang berulang dan saling menguatkan.
        </p>
      </div>

      <div data-reveal="fade-up">
        <PreschoolLoop />
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 3 — Enam Matra Perkembangan Usia Dini (6 Development Domains)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="space-y-4 max-w-2xl" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          FOKUS PERKEMBANGAN
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 leading-tight">
          Enam Matra Tumbuh Kembang Utuh
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Setiap aktivitas di kelas dirancang secara holistik untuk menstimulasi seluruh aspek potensi fitrah ananda secara proporsional.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        {/* Domain 1 */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-olive-950 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4" data-reveal="fade-up">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-tsls-wood-600">01</span>
            <span class="arabic-watermark text-sm text-tsls-olive-900/60">الإِيمَان وَالأَدَب</span>
          </div>
          <h4 class="font-display font-bold text-xl text-tsls-olive-950">Fitrah Keimanan & Adab</h4>
          <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
            Mengenalkan Allah sebagai Rabb pencipta alam, membiasakan doa harian, adab makan dan minum, mencintai Nabi Shallallahu 'Alaihi wa Sallam, serta lantunan surat-surat pendek Juz 'Amma secara merdu dan tanpa paksaan.
          </p>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] text-tsls-wood-700 font-semibold">
            Contoh: Menyimak kisah teladan, dzikir sebelum bermain, adab berbagi.
          </div>
        </div>

        {/* Domain 2 */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-sage-500 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4" data-reveal="fade-up" style="transition-delay: 100ms">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-tsls-wood-600">02</span>
            <span class="arabic-watermark text-sm text-tsls-olive-900/60">الاسْتِقْلَالِيَّة</span>
          </div>
          <h4 class="font-display font-bold text-xl text-tsls-olive-950">Kemandirian & Self-Care</h4>
          <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
            Melatih kemandirian dasar: meletakkan sepatu di rak, merapikan alat bermain pada tempatnya, mencuci tangan mandiri, membuka wadah bekal sendiri, dan pendampingan toilet training kooperatif.
          </p>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] text-tsls-wood-700 font-semibold">
            Contoh: Rutinitas membersihkan meja setelah makan, memakai kaos kaki.
          </div>
        </div>

        {/* Domain 3 */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-sand-400 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4" data-reveal="fade-up" style="transition-delay: 200ms">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-tsls-wood-600">03</span>
            <span class="arabic-watermark text-sm text-tsls-olive-900/60">اللُّغَة وَالبَيَان</span>
          </div>
          <h4 class="font-display font-bold text-xl text-tsls-olive-950">Bahasa & Komunikasi</h4>
          <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
            Memperkaya kosakata deskriptif, melatih kemampuan mendengar aktif dalam lingkaran cerita (*read-aloud*), berbicara santun, serta mengenalkan bunyi fonemik huruf hijaiyah dan latin secara kontekstual.
          </p>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] text-tsls-wood-700 font-semibold">
            Contoh: Menceritakan pengalaman akhir pekan, mendengarkan dongeng hikmah.
          </div>
        </div>

        {/* Domain 4 */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-wood-600 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4" data-reveal="fade-up">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-tsls-wood-600">04</span>
            <span class="arabic-watermark text-sm text-tsls-olive-900/60">العَلَاقَات وَالمَشَاعِر</span>
          </div>
          <h4 class="font-display font-bold text-xl text-tsls-olive-950">Sosio-Emosional</h4>
          <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
            Membantu anak mengenali ragam emosi dirinya (*senang, sedih, takut, kecewa*), belajar menenangkan diri (*self-regulation*), bergantian mainan (*turn-taking*), dan berinteraksi rukun bersama teman sebaya.
          </p>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] text-tsls-wood-700 font-semibold">
            Contoh: Bermain peran bersama, belajar meminta maaf dan memaafkan.
          </div>
        </div>

        {/* Domain 5 */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-sage-600 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4" data-reveal="fade-up" style="transition-delay: 100ms">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-tsls-wood-600">05</span>
            <span class="arabic-watermark text-sm text-tsls-olive-900/60">المَعْرِفَة وَالإِدْرَاك</span>
          </div>
          <h4 class="font-display font-bold text-xl text-tsls-olive-950">Kognitif & Pra-Matematika</h4>
          <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
            Menyelidiki hubungan sebab-akibat sederhana, klasifikasi warna dan ukuran, konsep perbandingan (*banyak-sedikit, berat-ringan*), serta mengenal pola spasial melalui benda konkret ciptaan Allah.
          </p>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] text-tsls-wood-700 font-semibold">
            Contoh: Menghitung daun gugur, menakar air, memilah biji-bijian alam.
          </div>
        </div>

        {/* Domain 6 */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-olive-800 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4" data-reveal="fade-up" style="transition-delay: 200ms">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-tsls-wood-600">06</span>
            <span class="arabic-watermark text-sm text-tsls-olive-900/60">النُّمُوّ الحَرَكِيّ</span>
          </div>
          <h4 class="font-display font-bold text-xl text-tsls-olive-950">Fisik & Motorik</h4>
          <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
            Stimulasi motorik halus (*meremas playdough alami, meronce, memegang krayon*) untuk kesiapan menulis, serta motorik kasar (*berlari di rumput, memanjat, melompat, menjaga keseimbangan*) di ruang terbuka.
          </p>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] text-tsls-wood-700 font-semibold">
            Contoh: Senam ceria pagi, rintangan balok titian, finger painting.
          </div>
        </div>

      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 4 — Zona Sentra Pembelajaran Onsite (Offline Experience)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          PENGALAMAN KELAS OFFLINE
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Zona Sentra Belajar di Sekolah
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Ruang kelas ditata menjadi area sentra terarah yang memerdekakan eksplorasi anak secara mandiri maupun berkelompok.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="p-6 bg-tsls-cream-100 border border-tsls-olive-950/15 space-y-3" data-reveal="fade-up">
          <div class="w-10 h-10 rounded-full bg-tsls-sage-500/20 text-tsls-olive-900 font-bold flex items-center justify-center font-mono text-sm">
            01
          </div>
          <h4 class="font-display font-bold text-lg text-tsls-olive-950">Sentra Bahan Alam</h4>
          <p class="text-xs text-tsls-olive-950/80 leading-relaxed">
            Area eksplorasi pasir bersih, air, bebatuan, dedaunan, dan ranting untuk melatih sensomotorik dan kepekaan rasa.
          </p>
        </div>

        <div class="p-6 bg-tsls-cream-100 border border-tsls-olive-950/15 space-y-3" data-reveal="fade-up" style="transition-delay: 100ms">
          <div class="w-10 h-10 rounded-full bg-tsls-sand-400/30 text-tsls-wood-700 font-bold flex items-center justify-center font-mono text-sm">
            02
          </div>
          <h4 class="font-display font-bold text-lg text-tsls-olive-950">Sentra Balok & Bangun</h4>
          <p class="text-xs text-tsls-olive-950/80 leading-relaxed">
            Menyusun balok kayu alami tanpa cat untuk mengasah penalaran ruang, simetri, gravitasi, dan kreativitas konstruksi.
          </p>
        </div>

        <div class="p-6 bg-tsls-cream-100 border border-tsls-olive-950/15 space-y-3" data-reveal="fade-up" style="transition-delay: 200ms">
          <div class="w-10 h-10 rounded-full bg-tsls-sage-500/20 text-tsls-olive-900 font-bold flex items-center justify-center font-mono text-sm">
            03
          </div>
          <h4 class="font-display font-bold text-lg text-tsls-olive-950">Sentra Main Peran</h4>
          <p class="text-xs text-tsls-olive-950/80 leading-relaxed">
            Menirukan kehidupan nyata, adab bertamu, pasar yang berkah, dan profesi mulia untuk memperkuat empati dan komunikasi.
          </p>
        </div>

        <div class="p-6 bg-tsls-cream-100 border border-tsls-olive-950/15 space-y-3" data-reveal="fade-up" style="transition-delay: 300ms">
          <div class="w-10 h-10 rounded-full bg-tsls-olive-800 text-tsls-cream-50 font-bold flex items-center justify-center font-mono text-sm">
            04
          </div>
          <h4 class="font-display font-bold text-lg text-tsls-olive-950">Sentra Perpustakaan Cilik</h4>
          <p class="text-xs text-tsls-olive-950/80 leading-relaxed">
            Pojok literasi dengan bantal empuk dan buku bergambar sirah, sains ramah anak, dan tilawah surat pendek yang tenang.
          </p>
        </div>

      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 5 — Ritme Keseharian di Preschool (Rhythm of the Day)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          RUTINITAS KESEHARIAN
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Contoh Ritme Hari di Preschool TSLS
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Ritme hari yang teratur memberi rasa aman pada anak, membantu mereka memprediksi aktivitas tanpa kecemasan.
        </p>
      </div>

      <div class="space-y-4 max-w-3xl mx-auto" data-reveal="fade-up">
        
        {/* Rhythm Step 1 */}
