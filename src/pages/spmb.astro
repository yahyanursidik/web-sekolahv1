---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ProgramCard from '../components/ui/ProgramCard.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';
import { PROGRAMS } from '../data/programs';
import { EXTERNAL_LINKS, SITE, SPMB as SPMB_INFO } from '../data/constants';

const steps = [
  {
    title: 'Kenali program',
    desc: 'Pahami usia, pola belajar, dan bentuk pendampingan pada setiap unit sebelum memutuskan.',
  },
  {
    title: 'Buat akun TSLS Hub',
    desc: 'Gunakan portal resmi yang terhubung langsung dengan proses SPMB dan verifikasi berkas.',
  },
  {
    title: 'Lengkapi formulir',
    desc: 'Isi informasi Ananda dan keluarga sesuai ketentuan yang tercantum pada portal.',
  },
  {
    title: 'Unggah dokumen',
    desc: 'Siapkan berkas digital (PDF atau foto JPG yang jernih) sesuai arahan portal.',
  },
  {
    title: 'Observasi & dialog orang tua',
    desc: 'Jadwal observasi ramah anak dan dialog penyelarasan visi dikirim melalui dashboard TSLS Hub.',
  },
  {
    title: 'Pantau hasil & tahapan lanjutan',
    desc: 'Ikuti status verifikasi dan petunjuk tahapan penerimaan berikutnya dari portal resmi.',
  },
];

const documents = [
  {
    title: 'Akta kelahiran calon murid',
    desc: 'Pindaian atau foto dokumen asli yang jelas dan terbaca untuk verifikasi usia masuk sekolah.',
  },
  {
    title: 'Kartu Keluarga (KK)',
    desc: 'Salinan Kartu Keluarga terbaru yang memuat nama calon murid dan orang tua.',
  },
  {
    title: 'KTP kedua orang tua / wali',
    desc: 'Identitas resmi ayah dan ibu atau wali calon murid yang masih berlaku.',
  },
  {
    title: 'Pas foto berwarna calon murid',
    desc: 'Foto terbaru dengan pakaian sopan dan latar belakang polos.',
  },
  {
    title: 'Buku KIA / riwayat tumbuh kembang',
    desc: 'Khusus jenjang TK, untuk pemetaan awal riwayat stimulasi dan kesehatan Ananda.',
  },
  {
    title: 'Rapor atau surat keterangan terakhir',
    desc: 'Khusus pendaftaran murid pindahan jenjang SD dari sekolah asal.',
  },
];

const faqs = [
  {
    q: 'Kapan periode pendaftaran SPMB dibuka?',
    a: 'Pendaftaran dibuka secara berkala melalui gelombang pendaftaran online di TSLS Hub. Kuota kelas dibatasi demi menjaga rasio guru–murid yang ideal, sehingga kami menyarankan keluarga mendaftar lebih awal.',
  },
  {
    q: 'Apakah ada tes calistung untuk masuk jenjang SD?',
    a: 'Tidak ada tes calistung yang bersifat seleksi eliminatif. Asesmen berbentuk observasi kesiapan belajar, kematangan emosi, daya fokus, serta kemandirian anak dalam suasana yang menyenangkan.',
  },
  {
    q: 'Mengapa ada sesi wawancara atau dialog dengan orang tua?',
    a: 'Pendidikan anak adalah amanah bersama. Dialog ditujukan untuk menyelaraskan visi pendidikan, pola asuh di rumah, dan komitmen sinergi antara keluarga dan sekolah.',
  },
  {
    q: 'Bagaimana memantau status berkas pendaftaran?',
    a: 'Seluruh tahapan verifikasi berkas, jadwal observasi, dan pengumuman hasil dapat dipantau melalui dashboard akun orang tua di portal TSLS Hub.',
  },
];
---

<Layout
  title={`${SPMB_INFO.label} | ${SITE.name}`}
  description={`Informasi penerimaan murid baru ${SPMB_INFO.academicYear} ${SITE.name}: alur pendaftaran, dokumen, dan portal resmi TSLS Hub.`}
>
  <PageHero
    eyebrow={`Penerimaan Murid Baru · ${SPMB_INFO.academicYear}`}
    title="Perjalanan belajar Ananda<br />dimulai dari sini."
    intro="Kenali program, konsultasikan kebutuhan keluarga, dan selesaikan pendaftaran melalui portal TSLS Hub. Jadwal gelombang, kuota, dan biaya mengikuti pengumuman resmi sekolah."
    crumbs={[{ href: '/', label: 'Beranda' }, { label: 'SPMB' }]}
  >
    <div class="hero__actions">
      <a class="btn btn--primary" href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener">
        Buka Portal Pendaftaran <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
      <a class="btn btn--light" href={EXTERNAL_LINKS.consultation} target="_blank" rel="noopener">
        Konsultasi School Center
      </a>
    </div>
    <div class="detail-metrics">
      <div>Pendaftaran terpusat di TSLS Hub</div>
      <div>Observasi ramah anak, tanpa beban calistung</div>
      <div>Dialog penyelarasan bersama orang tua</div>
    </div>
  </PageHero>

  <section class="section--tight">
    <div class="container">
      <SectionHead
        eyebrow="Tahapan pendaftaran"
        title="Proses yang jelas, langkah demi langkah."
        desc="Alur dirancang sederhana agar Abba & Umma mengetahui apa yang terjadi berikutnya."
      />
      <div class="steps">
        {
          steps.map((step, index) => (
            <article class="step">
              <b>{String(index + 1).padStart(2, '0')}</b>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </article>
          ))
        }
      </div>
      <div class="notice">
        Lengkapi halaman ini dengan jadwal gelombang, kuota, biaya, syarat administratif, status
        satuan pendidikan, mekanisme kunjungan, dan kebijakan pengembalian dana sesuai keputusan
        resmi sekolah sebelum dipublikasikan.
      </div>
    </div>
  </section>

  <section class="section--tight section--tint">
    <div class="container">
      <SectionHead
        eyebrow="Dokumen persyaratan"
        title="Siapkan dokumen sebelum memulai."
        desc="Unggah dokumen dalam format digital (PDF atau foto JPG yang jernih) saat mengisi formulir di portal."
      />
      <div class="content-grid">
        {
          documents.map((document, index) => (
            <article class="info-card">
              <span class="info-card__id">{String(index + 1).padStart(2, '0')}</span>
              <h3>{document.title}</h3>
              <p>{document.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <SectionHead
        eyebrow="Tiga pilihan program"
        title="Temukan program yang sesuai."
        desc="Telaah program sebelum membuka portal pendaftaran."
      />
      <div class="program-grid">
        {PROGRAMS.map((program) => <ProgramCard program={program} />)}
      </div>
    </div>
  </section>

  <section class="section--tight section--tint">
    <div class="container">
      <SectionHead
        eyebrow="Pertanyaan umum SPMB"
        title="Yang sering ditanyakan sebelum mendaftar."
        linkHref="/faq"
        linkLabel="Lihat semua FAQ"
      />
      <FaqAccordion items={faqs} />
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Siap mendaftarkan Ananda?</h2>
          <p>
            Pendaftaran publik dan akses orang tua aktif dibedakan di dalam portal. Gunakan tautan di
            samping sesuai kebutuhan Anda.
          </p>
        </div>
        <div class="cta-band__actions">
          <a class="btn btn--white" href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener">
            Daftar di TSLS Hub <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
          <a
            class="btn btn--outline-white"
            href={EXTERNAL_LINKS.consultation}
            target="_blank"
            rel="noopener"
          >
            Konsultasi
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
