---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
import { cn } from '../lib/utils';
import { EXTERNAL_LINKS } from '../data/constants';
import SPMBTimeline from '../components/diagrams/SPMBTimeline.astro';

const spmbPrograms = [
  {
    type: "ONSITE",
    title: "Preschool Onsite",
    age: "Usia 3–6 Tahun (KB & TK IT)",
    desc: "Pendidikan anak usia dini holistik berbasis fitrah dengan sentra bahan alam, pembiasaan adab salaf, serta interaksi sosial nyata di sekolah.",
    features: [
      "Rasio guru & murid 1 : 6 yang hangat",
      "Sentra bahan alam & playground outdoor",
      "Pembiasaan adab harian serta doa dan dzikir pagi petang",
      "Stimulasi motorik kasar & sensorik alami"
    ],
    link: "/preschool",
    tagColor: "text-tsls-olive-900 bg-tsls-sage-500/20"
  },
  {
    type: "HOME-BASED",
    title: "Preschool HBL",
    age: "Usia 3–6 Tahun (Home-Based)",
    desc: "Pembelajaran dari rumah terstruktur dengan modul bermutu, 2 hari Live Meeting (Talaqqi & Tematik Diniyah), serta bimbingan konsultasi orang tua.",
    features: [
      "2 Hari Live Meeting + 3 Hari Mandiri",
      "Modul cetak tematik & video panduan",
      "Konsultasi 1-on-1 bersama guru",
      "Standar capaian perkembangan STTPA"
    ],
    link: "/preschool-hbl",
    tagColor: "text-tsls-wood-700 bg-tsls-sand-400/30"
  },
  {
    type: "ONSITE",
    title: "Elementary School (PKBM)",
    age: "Usia 6–12 Tahun (PKBM Setara SD)",
    desc: "Pendidikan dasar Islam yang mengintegrasikan Al-Qur'an bersanad, multiliterasi 4 bahasa, sains islami kauniyah, serta kepemimpinan beradab.",
    features: [
      "Halaqah Al-Qur'an: Tahsin bersanad & Tahfiz",
      "Nalar kritis & Deep Learning (Tanpa ranking)",
      "Shalat Zhuhur di masjid (khusus ikhwan)",
      "Kesiapan jenjang SMP / Pesantren Salaf"
    ],
    link: "/elementary",
    tagColor: "text-tsls-olive-950 bg-tsls-cream-200"
  }
];

const documentRequirements = [
  {
    title: "Akta Kelahiran Calon Murid",
    desc: "Scan / foto dokumen asli yang jelas dan terbaca untuk verifikasi usia masuk sekolah."
  },
  {
    title: "Kartu Keluarga (KK)",
    desc: "Salinan Kartu Keluarga terbaru yang memuat nama calon murid dan orang tua."
  },
  {
    title: "KTP Kedua Orang Tua / Wali",
    desc: "Identitas resmi ayah dan ibu / wali calon murid yang masih berlaku."
  },
  {
    title: "Pas Foto Berwarna Calon Murid",
    desc: "Foto terbaru dengan pakaian sopan dan latar belakang polos."
  },
  {
    title: "Buku KIA / Riwayat Tumbuh Kembang",
    desc: "Khusus jenjang Preschool untuk pemetaan awal riwayat stimulasi dan kesehatan ananda."
  },
  {
    title: "Surat Keterangan / Rapor Terakhir",
    desc: "Khusus pendaftaran pindahan jenjang Elementary School dari sekolah asal."
  }
];

const spmbFaqs = [
  {
    q: "Kapan periode pendaftaran SPMB dibuka?",
    a: "Pendaftaran dibuka secara berkala melalui gelombang pendaftaran online di TSLS Hub. Kuota kelas dibatasi demi menjaga rasio guru-murid yang ideal, sehingga kami menyarankan orang tua mendaftar lebih awal."
  },
  {
    q: "Apakah ada tes membaca, menulis, atau berhitung (Calistung) untuk masuk jenjang Elementary?",
    a: "Tidak ada tes calistung yang bersifat seleksi eliminatif kaku. Asesmen di TSLS berbentuk observasi kesiapan belajar, kematangan emosi, daya fokus, serta kemandirian anak dalam suasana yang menyenangkan."
  },
  {
    q: "Mengapa ada sesi wawancara / dialog dengan orang tua?",
    a: "Pendidikan anak adalah amanah bersama. Dialog orang tua ditujukan untuk menyelaraskan visi pendidikan manhaj Salafus Shalih, pola asuh di rumah, dan komitmen sinergi antara keluarga dan sekolah."
  },
  {
    q: "Bagaimana cara memantau status kelulusan berkas pendaftaran?",
    a: "Seluruh tahapan verifikasi berkas, jadwal observasi, dan pengumuman hasil dapat dipantau langsung 24/7 melalui dashboard akun orang tua di portal TSLS Hub."
  }
];
---

<Layout title="Penerimaan Murid Baru (SPMB) | Tarbiyah Sunnah Lab School">

  {/* =========================================================================
      Hero Section (SPMB TSLS)
     ========================================================================= */}
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-tsls-cream-50 overflow-hidden border-b border-tsls-olive-950/10">
    
    {/* Subtle Arabic Watermark Background */}
    <div class="absolute right-0 top-1/3 -translate-y-1/2 opacity-[0.03] pointer-events-none select-none z-0">
      <span class="arabic-watermark text-[140px] md:text-[240px] font-normal leading-none text-tsls-olive-950" dir="rtl">
        القَبُولُ وَالتَّسْجِيل
      </span>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8 relative z-10" data-reveal>
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-tsls-sage-500/20 border border-tsls-sage-500/40 text-tsls-olive-950 text-xs font-mono font-bold tracking-widest uppercase">
        PENERIMAAN PESERTA DIDIK BARU (SPMB) · TA 2026/2027
      </div>
      
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-tsls-olive-950 leading-[1.12] tracking-tight text-balance">
        Langkah Awal Menapaki<br />
        <span class="italic font-serif font-normal text-tsls-wood-600">Pendidikan Fitrah Rabbani.</span>
      </h1>

      <p class="text-base sm:text-lg text-tsls-olive-950/80 leading-relaxed max-w-3xl mx-auto text-pretty">
        Selamat datang di gerbang penerimaan murid baru Tarbiyah Sunnah Lab School. Seluruh proses pengisian formulir, unggah dokumen, hingga pemantauan status seleksi dilakukan secara terpusat, aman, dan transparan melalui portal digital <strong>TSLS Hub</strong>.
      </p>

      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a href={EXTERNAL_LINKS.spmb} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ size: 'lg' }), 'bg-tsls-olive-950 text-tsls-cream-50 hover:bg-tsls-olive-800 font-bold px-10 rounded-none shadow-md')}>
          Mulai Pendaftaran Online (TSLS Hub) &rarr;
        </a>
        <a href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'border-tsls-olive-950 text-tsls-olive-950 hover:bg-tsls-olive-950 hover:text-tsls-cream-50 font-bold px-10 rounded-none transition-colors')}>
          Masuk Akun Orang Tua
        </a>
      </div>

      {/* 3 Value Badges */}
      <div class="pt-10 border-t border-tsls-olive-950/10 grid grid-cols-1 sm:grid-cols-3 gap-6 text-left max-w-4xl mx-auto">
        <div class="p-4 bg-tsls-cream-100 border border-tsls-olive-950/10">
          <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">100% Terintegrasi</div>
          <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-1">Paperless & Praktis dari Mana Saja</div>
        </div>
        <div class="p-4 bg-tsls-cream-100 border border-tsls-olive-950/10">
          <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Observasi Ramah Anak</div>
          <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-1">Pemetaan Fitrah Tanpa Beban Calistung</div>
        </div>
        <div class="p-4 bg-tsls-cream-100 border border-tsls-olive-950/10">
          <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Sinergi Orang Tua</div>
          <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-1">Penyelarasan Nilai Manhaj & Pola Asuh</div>
        </div>
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 1 — Pilihan Program Pendidikan SPMB
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          PILIHAN JENJANG PENDIDIKAN
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Jenjang Program yang Dibuka
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Pilih program yang paling selaras dengan tahap tumbuh kembang ananda dan ritme pengasuhan keluarga Anda.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {spmbPrograms.map((prog, idx) => (
          <div 
            class="p-8 bg-tsls-cream-50 border border-tsls-olive-950/15 shadow-sm space-y-6 flex flex-col justify-between"
            data-reveal="fade-up"
            style={`transition-delay: ${idx * 80}ms`}
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between border-b border-tsls-olive-950/10 pb-2.5">
                <span class={`text-[10px] font-mono font-bold tracking-wider uppercase px-2.5 py-0.5 ${prog.tagColor}`}>
                  {prog.type}
                </span>
                <span class="text-xs font-mono text-tsls-wood-600 font-bold">
                  {prog.age}
                </span>
              </div>

              <h3 class="font-display font-bold text-2xl text-tsls-olive-950">
                {prog.title}
              </h3>

              <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
                {prog.desc}
              </p>

              <div class="pt-2 border-t border-tsls-olive-950/10 space-y-2">
                <span class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold block">
                  Keunggulan Program:
                </span>
                <ul class="space-y-1.5 text-xs text-tsls-olive-950/80">
                  {prog.features.map((ft) => (
                    <li class="flex items-start gap-2">
                      <span class="text-tsls-olive-900 font-bold shrink-0">✓</span>
                      <span>{ft}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-tsls-olive-950/10 flex items-center justify-between gap-4">
              <a href={prog.link} class="text-xs font-bold text-tsls-olive-950 hover:text-tsls-wood-600 transition-colors uppercase tracking-wider">
                Pelajari Kurikulum &rarr;
              </a>
              <a href={EXTERNAL_LINKS.spmb} target="_blank" rel="noopener noreferrer" class="text-xs font-bold px-3 py-1.5 bg-tsls-olive-950 text-tsls-cream-50 hover:bg-tsls-olive-800 transition-colors">
                Daftar &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 2 — Alur & Tahapan Pendaftaran (Interactive Stepper)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          TAHAPAN PENDAFTARAN
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Alur Pendaftaran SPMB TSLS
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Enam tahapan mudah dan terarah mulai dari registrasi akun hingga penyambutan keluarga baru.
        </p>
      </div>

      <SPMBTimeline />

      {/* Info Alert Box */}
      <div class="p-6 bg-tsls-cream-100 border-l-4 border-tsls-olive-950 border-y border-r border-tsls-olive-950/15 shadow-sm text-xs sm:text-sm text-tsls-olive-950/85 leading-relaxed max-w-3xl mx-auto" data-reveal="fade-up">
        <strong class="text-tsls-olive-950 font-bold block mb-1">Catatan Penting untuk Orang Tua:</strong>
        Setelah data dan dokumen diunggah, tim verifikator TSLS akan memeriksa kelengkapan berkas Anda. Jadwal observasi anak dan dialog orang tua akan dikirimkan otomatis melalui dashboard TSLS Hub dan notifikasi WhatsApp resmi.
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 3 — Persyaratan Dokumen Digital
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          DOKUMEN PERSYARATAN
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 leading-tight">
          Siapkan Dokumen Sebelum Memulai
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Unggah dokumen dalam format digital (PDF atau foto JPG jernih) saat mengisi formulir di portal TSLS Hub.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal="fade-up">
        {documentRequirements.map((doc, idx) => (
          <div class="p-6 bg-tsls-cream-50 border border-tsls-olive-950/15 space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-tsls-olive-950 text-tsls-cream-50 text-xs font-bold flex items-center justify-center font-mono">
                {idx + 1}
              </span>
              <h4 class="font-display font-bold text-base text-tsls-olive-950">
                {doc.title}
              </h4>
            </div>
            <p class="text-xs text-tsls-olive-950/75 leading-relaxed pl-7">
              {doc.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 4 — Pertanyaan Umum SPMB (FAQ)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center space-y-4" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          TANYA JAWAB SPMB
        </div>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-tsls-olive-950">
          Pertanyaan Seputar Pendaftaran
        </h2>
      </div>

      <div class="divide-y divide-tsls-olive-950/15 border-y border-tsls-olive-950/15" data-reveal="fade-up">
        {spmbFaqs.map((faq) => (
          <div class="py-8 space-y-2">
            <h4 class="font-display font-bold text-lg text-tsls-olive-950">
              {faq.q}
            </h4>
            <p class="text-sm text-tsls-olive-950/80 leading-relaxed text-pretty">
              {faq.a}
            </p>
          </div>
        ))}
      </div>

      <div class="text-center pt-2" data-reveal>
        <a href="/faq" class="inline-flex items-center gap-2 text-xs font-bold text-tsls-olive-950 uppercase tracking-widest hover:text-tsls-wood-600 transition-colors">
          Lihat FAQ Lengkap Sekolah &rarr;
        </a>
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 5 — CTA & Portal Pendaftaran
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-olive-950 text-tsls-cream-50 text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-8" data-reveal>
      <span class="text-xs font-mono uppercase tracking-widest text-tsls-sand-400 font-bold block">
        MULAI PENDAFTARAN ONLINE
      </span>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold">
        Siap Bergabung Bersama TSLS?
      </h2>
      <p class="text-base sm:text-lg text-tsls-cream-100/80 leading-relaxed text-pretty">
        Data pendaftaran dikelola secara aman melalui portal terpusat TSLS Hub. Pastikan menyiapkan nomor WhatsApp dan email aktif Anda.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a href={EXTERNAL_LINKS.spmb} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ size: 'lg' }), 'bg-tsls-cream-50 text-tsls-olive-950 hover:bg-tsls-cream-200 font-bold px-10 rounded-none shadow-md')}>
          Buka Formulir SPMB di TSLS Hub &rarr;
        </a>
        <a href="/kontak" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'border-tsls-sand-400 text-tsls-sand-400 hover:bg-tsls-sand-400 hover:text-tsls-olive-950 font-bold px-10 rounded-none transition-colors')}>
          Konsultasi Admin SPMB
        </a>
      </div>
    </div>
  </section>

</Layout>
