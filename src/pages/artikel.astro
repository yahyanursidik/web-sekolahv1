---
import Layout from '../layouts/Layout.astro';

import { getCollection } from 'astro:content';

const allArticles = await getCollection('artikel');
// Sort newest first
allArticles.sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());

const editorChoice = allArticles.find(a => a.data.isEditorChoice) || allArticles[0];
const otherArticles = editorChoice ? allArticles.filter(a => a.id !== editorChoice.id) : allArticles;

const popularArticles = allArticles.slice(0, 3);
---
<Layout>

<style is:global>
    .pattern-overlay {
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 0l2.598 15L45 17.402 32.598 20 30 35l-2.598-15L15 17.402 27.402 15z' fill='%233f4e2f' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
    }
    
    @media (prefers-reduced-motion: no-preference) {
        .reveal-up {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal-up.active {
            opacity: 1;
            transform: translateY(0);
        }
        
        @keyframes soft-pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.9; transform: scale(1.02); }
        }
        .animate-soft-pulse {
            animation: soft-pulse 3s ease-in-out infinite;
        }
        
        .hover-lift {
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }
    }
</style>

<main class="pt-24 pb-section-padding-desktop pattern-overlay">
<!-- Hero Section -->
<section class="max-w-container-max mx-auto px-gutter mb-16 text-center reveal-up active">
<h1 class="font-display-lg text-display-lg text-primary mb-4">Artikel &amp; Edukasi</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
                Menyajikan wawasan mendalam seputar parenting Islami, metode pendidikan anak berdasarkan fitrah, dan mutiara hikmah Al-Qur'an untuk membimbing ananda tercinta.
            </p>
</section>
<!-- Category Filter -->
<section class="max-w-container-max mx-auto px-gutter mb-12 reveal-up active" style="transition-delay: 100ms;">
<div class="flex flex-wrap justify-center gap-3">
<button class="px-6 py-2 rounded-full bg-primary text-on-primary font-medium shadow-sm transition-all hover:opacity-90 hover:-translate-y-1">Semua</button>
<button class="px-6 py-2 rounded-full bg-surface-container text-on-surface-variant hover:bg-primary-fixed-dim hover:text-primary transition-all font-medium hover:-translate-y-1">Parenting Islami</button>
<button class="px-6 py-2 rounded-full bg-surface-container text-on-surface-variant hover:bg-primary-fixed-dim hover:text-primary transition-all font-medium hover:-translate-y-1">Pendidikan Anak</button>
<button class="px-6 py-2 rounded-full bg-surface-container text-on-surface-variant hover:bg-primary-fixed-dim hover:text-primary transition-all font-medium hover:-translate-y-1">Al-Qur'an</button>
<button class="px-6 py-2 rounded-full bg-surface-container text-on-surface-variant hover:bg-primary-fixed-dim hover:text-primary transition-all font-medium hover:-translate-y-1">Adab &amp; Akhlak</button>
<button class="px-6 py-2 rounded-full bg-surface-container text-on-surface-variant hover:bg-primary-fixed-dim hover:text-primary transition-all font-medium hover:-translate-y-1">Kegiatan Sekolah</button>
</div>
</section>
<div class="max-w-container-max mx-auto px-gutter grid grid-cols-1 lg:grid-cols-12 gap-gutter">
<!-- Main Content Area -->
<div class="lg:col-span-8 space-y-12">
<!-- Featured Article -->
{editorChoice && (
<article class="group relative bg-surface-container-lowest rounded-lg overflow-hidden border border-outline-variant/30 flex flex-col md:flex-row hover-lift reveal-up active" style="transition-delay: 200ms;"><div class="md:w-1/2 h-64 md:h-auto overflow-hidden">
<img alt="Featured Article" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src={editorChoice.data.thumbnail || "https://lh3.googleusercontent.com/aida-public/AB6AXuDmzkKM5stq1ZOeNzj6zclPCLA2xIR-a8rQ9ZrvdaJImDMn4efVivn9TwZC-dB2fFguFNq8cChWSjDuuAdOLvQNR9mPhs2uncFo7AexvDPVnnOYJPrbx7NqI4-vjeTzHl__wk736cddSZF30IfaCCo5WT7qGdCZeU8VtA7MM1ykzS-pNVIkat7h1pGlzQq-fWgLJ_iT_jbX02qTEVlE8Yowjub3AujRftd4XbHjUZEOQEtKLZ43WfY19p6EaypSnAlWfhpmpNRcwCY"}>
</div>
<div class="md:w-1/2 p-10 flex flex-col justify-center">
<div class="flex items-center gap-2 mb-4">
<span class="px-3 py-1 rounded-full bg-secondary text-on-secondary font-label-caps text-[10px] tracking-wider">EDITOR'S CHOICE</span>
<a href={`/kategori/${editorChoice.data.category ? editorChoice.data.category.toLowerCase().replace(/\s+/g, '-') : 'umum'}`} class="text-on-tertiary-fixed-variant font-label-caps text-label-caps hover:underline">{editorChoice.data.category || 'Umum'}</a>
</div>
<h2 class="font-headline-md text-3xl lg:text-4xl text-primary mb-6 group-hover:text-secondary transition-colors"><a href={`/artikel/${editorChoice.id}`}>{editorChoice.data.title}</a></h2>
<div class="flex items-center gap-4 mt-auto">
<div class="text-sm">
<span class="block text-outline text-xs">{editorChoice.data.date || ''}</span>
</div>
<a class="ml-auto flex items-center gap-2 text-primary font-bold hover:gap-3 transition-all" href={`/artikel/${editorChoice.id}`}>
                                Baca Selengkapnya 
                                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</div>
</div></article>
)}<section class="py-8 reveal-up active" style="transition-delay: 100ms;">
<h3 class="font-headline-sm text-primary mb-6">Saran Bacaan Berdasarkan Kategori</h3>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
<a class="flex flex-col items-center justify-center p-6 bg-surface-container-low hover:bg-primary-fixed transition-all rounded-xl border border-outline-variant/30 text-center hover-lift" href="/kategori/parenting-islami">
<span class="material-symbols-outlined text-primary text-4xl mb-3 transition-transform group-hover:scale-110">groups</span>
<span class="text-sm font-bold text-primary">Parenting Islami</span>
</a>
<a class="flex flex-col items-center justify-center p-6 bg-surface-container-low hover:bg-primary-fixed transition-all rounded-xl border border-outline-variant/30 text-center hover-lift" href="/kategori/al-quran">
<span class="material-symbols-outlined text-primary text-4xl mb-3 transition-transform group-hover:scale-110">menu_book</span>
<span class="text-sm font-bold text-primary">Al-Qur'an</span>
</a>
<a class="flex flex-col items-center justify-center p-6 bg-surface-container-low hover:bg-primary-fixed transition-all rounded-xl border border-outline-variant/30 text-center hover-lift" href="/kategori/adab-&-akhlak">
<span class="material-symbols-outlined text-primary text-4xl mb-3 transition-transform group-hover:scale-110">psychology</span>
<span class="text-sm font-bold text-primary">Adab & Akhlak</span>
</a>
<a class="flex flex-col items-center justify-center p-6 bg-surface-container-low hover:bg-primary-fixed transition-all rounded-xl border border-outline-variant/30 text-center hover-lift" href="/kategori/kegiatan-sekolah">
<span class="material-symbols-outlined text-primary text-4xl mb-3 transition-transform group-hover:scale-110">forest</span>
<span class="text-sm font-bold text-primary">Kegiatan Sekolah</span>
</a>
</div>
</section>
<!-- Article Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-gutter"><div class="col-span-full mb-4 reveal-up active">
<h3 class="font-headline-sm text-primary">Artikel Sedang Tren</h3>
</div>
{otherArticles.map((article, index) => (
  <article class="article-card bg-surface-container-lowest rounded-lg overflow-hidden border border-outline-variant/20 hover-lift flex flex-col reveal-up active" style={`transition-delay: ${index * 100}ms;`} data-title={article.data.title.toLowerCase()}>
  <div class="h-48 overflow-hidden group">
  <img alt="Article Image" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" src={article.data.thumbnail || "https://lh3.googleusercontent.com/aida-public/AB6AXuCA-rysNjmN3BViCZ84QwnimAVvpdTuPtGsd_4-XoXMoN4c4qqqXeF13PMIC1WTjFM8eUDxlfhb43DONTzAhAZDzPP7B9KboA3sKn8UrKTwrx7Jcch6P63efim-bo17rcGkRIM-CaDQ-DYppXSY0Z8D-sC0HQ72iuJBONUyxjb5HqJLgUhWP4VFztBwdKx_v_LgwjfNQVO63y9-KaPF1fKdX0UvLEX0K6a1364jZmHDXUZe7jIc0r-AEfLXLaSbRSV1OZ2oAbDrV28"}>
  </div>
  <div class="p-6 flex flex-col flex-grow group">
  <a href={`/kategori/${article.data.category ? article.data.category.toLowerCase().replace(/\s+/g, '-') : 'umum'}`} class="inline-block px-3 py-1 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-caps text-label-caps mb-3 w-fit hover:opacity-80 transition-opacity">{article.data.category || 'Umum'}</a>
  <h3 class="font-headline-sm text-headline-sm text-primary mb-3 group-hover:text-secondary transition-colors"><a href={`/artikel/${article.id}`}>{article.data.title}</a></h3>
  <div class="flex items-center justify-between mt-auto pt-4 border-t border-outline-variant/10">
  <span class="text-label-caps text-outline">{article.data.date || ''}</span>
  <a class="text-primary font-bold text-sm hover:underline transition-all" href={`/artikel/${article.id}`}>Baca Selengkapnya</a>
  </div>
  </div>
  </article>
))}
</div>
<!-- Pagination -->
<div class="flex justify-center pt-8 reveal-up active">
<button class="bg-primary text-on-primary px-10 py-4 rounded-full font-medium shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all flex items-center gap-3">
                        Muat Lebih Banyak
                        <span class="material-symbols-outlined transition-transform group-hover:translate-y-1">expand_more</span>
</button>
</div>
</div>
<!-- Sidebar -->
<aside class="lg:col-span-4 space-y-8">
<!-- Search -->
<div class="bg-surface-container-high p-6 rounded-lg reveal-up active">
<h4 class="font-headline-sm text-headline-sm text-primary mb-4">Cari Artikel</h4>
<div class="relative">
<input id="searchInput" class="w-full bg-surface-container-lowest border-outline-variant rounded-full px-6 py-3 focus:border-primary focus:ring-2 focus:ring-primary/50 outline-none text-sm transition-all focus:scale-[1.02]" placeholder="Masukkan kata kunci..." type="text">
<button class="absolute right-3 top-1/2 -translate-y-1/2 text-primary hover:scale-110 transition-transform">
<span class="material-symbols-outlined">search</span>
</button>
</div>
</div>
<!-- Popular Articles -->
<div class="bg-surface-container p-6 rounded-lg border border-outline-variant/30 reveal-up active" style="transition-delay: 100ms;">
<h4 class="font-headline-sm text-headline-sm text-primary mb-6">Artikel Populer</h4>
<div class="space-y-6">
{popularArticles.map((article) => (
<a class="group flex gap-4 transition-transform hover:translate-x-2" href={`/artikel/${article.id}`}>
<div class="w-16 h-16 rounded bg-surface-dim overflow-hidden flex-shrink-0">
<img alt="Miniature" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src={article.data.thumbnail || "https://lh3.googleusercontent.com/aida-public/AB6AXuBl1UDqfbgqmZfTg4Ia5K153ES8C8VWxSZZRzrrbbUn7rGCuRBLKaHluvpXZF57okEuCmR4Nz8qtBBz-qBge3zSKh40xJLkwfw_SXjR4ew4DF9dJ_Bxqvx3xqnr6kqpzLzXUEMf6kCFvoHchcRSt-AoE-ExPdTVudK6zJom23dwinbSjlE6Oj4yNs05Ii9UZlnNSveSdhSLNWDq62S6zh5qt1qVPtFMxvb7FXs81tasKHanvVpXYYL2ahI-RiZnu97ku_eg0mIs3GU"}>
</div>
<div>
<h5 class="text-sm font-bold text-primary group-hover:text-secondary leading-tight mb-1 transition-colors line-clamp-2">{article.data.title}</h5>
<span class="text-[10px] text-outline font-label-caps">{article.data.date || ''}</span>
</div>
</a>
))}
</div>
</div>
<!-- Newsletter / Subscribe -->
<div class="bg-surface-container-highest p-6 rounded-lg border border-outline-variant/50 reveal-up active" style="transition-delay: 200ms;">
<h4 class="font-headline-sm text-headline-sm text-primary mb-6">Agenda Edukasi</h4>
<div class="space-y-4">
<a class="group flex gap-4 p-3 bg-background rounded-lg border border-outline-variant/30 hover:border-primary/50 transition-all hover:-translate-y-1 block" href="#">
<div class="bg-primary text-on-primary w-12 h-12 flex flex-col items-center justify-center rounded flex-shrink-0 group-hover:bg-secondary transition-colors">
<span class="text-xs font-bold leading-none">25</span>
<span class="text-[10px] uppercase font-label-caps">Okt</span>
</div>
<div>
<h5 class="text-sm font-bold text-primary leading-tight group-hover:text-secondary transition-colors">Webinar: Menjaga Fitrah Anak</h5>
<p class="text-[10px] text-outline flex items-center gap-1 mt-1"><span class="material-symbols-outlined text-[12px]">schedule</span> 19.30 WIB</p>
</div>
</a>
<a class="group flex gap-4 p-3 bg-background rounded-lg border border-outline-variant/30 hover:border-primary/50 transition-all hover:-translate-y-1 block" href="#">
<div class="bg-primary text-on-primary w-12 h-12 flex flex-col items-center justify-center rounded flex-shrink-0 group-hover:bg-secondary transition-colors">
<span class="text-xs font-bold leading-none">02</span>
<span class="text-[10px] uppercase font-label-caps">Nov</span>
</div>
<div>
<h5 class="text-sm font-bold text-primary leading-tight group-hover:text-secondary transition-colors">Talkshow: Adab dalam Belajar</h5>
<p class="text-[10px] text-outline flex items-center gap-1 mt-1"><span class="material-symbols-outlined text-[12px]">location_on</span> Kampus TS Lab School</p>
</div>
</a>
</div>
<a class="w-full mt-6 text-primary font-bold text-sm border-b border-primary/20 pb-1 hover:border-primary hover:tracking-wide transition-all block text-center" href="/artikel">Lihat Semua Artikel</a>
</div><div class="bg-primary text-on-primary p-8 rounded-lg shadow-xl relative overflow-hidden reveal-up active" style="transition-delay: 300ms;">
<div class="relative z-10">
<h4 class="font-headline-sm text-headline-sm mb-4">Berlangganan Insight</h4>
<p class="text-sm text-on-primary/80 mb-6">Dapatkan artikel terbaru seputar pendidikan Islami langsung di email Anda setiap minggu.</p>
<input class="w-full bg-white/10 border-white/20 rounded-full px-5 py-3 mb-4 text-white placeholder-white/50 focus:bg-white/20 focus:outline-none transition-all focus:scale-[1.02] focus:shadow-inner" placeholder="Email Anda" type="email">
<button class="w-full bg-secondary-container text-on-secondary-container font-bold py-3 rounded-full hover:bg-secondary-fixed-dim transition-all animate-soft-pulse hover:animate-none hover:scale-105 active:scale-95 shadow-md hover:shadow-lg">Daftar Sekarang</button>
</div>
<!-- Decorative Background Circle -->
<div class="absolute -right-8 -bottom-8 w-32 h-32 bg-secondary-container/20 rounded-full transition-transform duration-700 hover:scale-150"></div>
</div>
</aside>
</div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Search Functionality
        const searchInput = document.getElementById('searchInput') as HTMLInputElement;
        const articleCards = document.querySelectorAll('.article-card') as NodeListOf<HTMLElement>;

        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const query = (e.target as HTMLInputElement).value.toLowerCase();
                articleCards.forEach(card => {
                    const title = card.getAttribute('data-title') || '';
                    if (title.includes(query)) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        }

        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal-up').forEach(el => {
            observer.observe(el);
        });
        
        // Trigger initial animation for elements already in viewport
        setTimeout(() => {
            document.querySelectorAll('.reveal-up').forEach(el => {
                if(el.getBoundingClientRect().top < window.innerHeight) {
                    el.classList.add('active');
                }
            });
        }, 100);
    });
</script>
</Layout>
