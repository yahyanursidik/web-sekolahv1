---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import faqData from '../content/settings/faq.json';
import { SITE } from '../data/constants';

/** faq.json memakai \n\n untuk paragraf, \n untuk butir, dan \t untuk kolom tabel. */
const formatAnswer = (text: string) => {
  if (!text) return '';
  return text
    .split('\n\n')
    .map((block) => {
      const lines = block.split('\n').filter(Boolean);

      if (lines.some((line) => line.includes('\t'))) {
        const rows = lines
          .map((line, rowIndex) => {
            const cells = line
              .split('\t')
              .map((cell) =>
                rowIndex === 0 ? `<th scope="col">${cell}</th>` : `<td>${cell}</td>`
              )
              .join('');
            return `<tr>${cells}</tr>`;
          })
          .join('');
        return `<div class="faq-table"><table>${rows}</table></div>`;
      }

      if (lines.length > 1) {
        const items = lines
          .map((line) => `<li>${line.replace(/^\d+\.\s*/, '').trim()}</li>`)
          .join('');
        return `<ul>${items}</ul>`;
      }

      return `<p>${block}</p>`;
    })
    .join('');
};

const sections = faqData.sections.map((section, index) => ({
  ...section,
  id: `faq-${index}`,
}));
---

<Layout title={`FAQ | ${SITE.name}`} description={faqData.description}>
  <PageHero
    eyebrow="Pertanyaan umum"
    title="Yang sering ditanyakan<br />Abba & Umma."
    intro={faqData.description}
    crumbs={[{ href: '/', label: 'Beranda' }, { label: 'FAQ' }]}
  />

  <section class="section--tight">
    <div class="container faq-layout">
      <aside class="faq-toc" aria-label="Kategori FAQ">
        <h2>Kategori</h2>
        <ul>
          {sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
        </ul>
      </aside>

      <div>
        {
          sections.map((section) => (
            <section id={section.id} class="faq-section">
              <h2>{section.title}</h2>
              <div class="faq-list" style="margin-inline:0;max-width:none">
                {section.faqs.map((faq) => (
                  <details>
                    <summary>{faq.question}</summary>
                    <div class="faq-answer" set:html={formatAnswer(faq.answer)} />
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Ada pertanyaan yang belum terjawab?"
    desc="Tim School Center dapat membantu memberikan informasi program dan pendaftaran."
  />
</Layout>

<style>
  .faq-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .faq-toc {
    position: sticky;
    top: 110px;
    border: 1px solid var(--tsls-line);
    border-radius: 18px;
    background: #fff;
    padding: 24px;
  }

  .faq-toc h2 {
    margin-bottom: 14px;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3d6d5b;
  }

  .faq-toc ul {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .faq-toc a {
    display: block;
    color: var(--tsls-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .faq-toc a:hover {
    color: var(--tsls-ink);
    text-decoration: underline;
  }

  .faq-section + .faq-section {
    margin-top: 44px;
  }

  .faq-section > h2 {
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .faq-answer {
    margin-bottom: 22px;
    color: var(--tsls-muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .faq-answer :global(p + p),
  .faq-answer :global(ul),
  .faq-answer :global(.faq-table) {
    margin-top: 12px;
  }

  .faq-answer :global(ul) {
    margin-left: 18px;
    padding: 0;
  }

  .faq-answer :global(li) {
    margin-bottom: 6px;
  }

  .faq-answer :global(.faq-table) {
    overflow-x: auto;
    border: 1px solid var(--tsls-line);
    border-radius: 12px;
  }

  .faq-answer :global(table) {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .faq-answer :global(th),
  .faq-answer :global(td) {
    border-bottom: 1px solid var(--tsls-line);
    padding: 10px 14px;
    vertical-align: top;
  }

  .faq-answer :global(th) {
    background: var(--tsls-surface-2);
    color: var(--tsls-ink);
    font-weight: 800;
  }

  .faq-answer :global(tr:last-child td) {
    border-bottom: 0;
  }

  @media (max-width: 920px) {
    .faq-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .faq-toc {
      position: static;
    }
  }
</style>
