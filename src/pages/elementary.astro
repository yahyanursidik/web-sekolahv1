---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
import { cn } from '../lib/utils';
import { EXTERNAL_LINKS } from '../data/constants';
import WholeChildMap from '../components/diagrams/WholeChildMap.astro';
import LanguageSpiral from '../components/diagrams/LanguageSpiral.astro';

interface Pillar {
  num: string;
  title: string;
  subtitle: string;
  desc: string;
  accentBg: string;
  borderColor: string;
}

const pillars: Pillar[] = [
  {
    num: "01",
    title: "Al-Qur'an (Tahsin & Hafalan)",
    subtitle: "تَحْسِينٌ وَتَحْفِيظ",
    desc: "Program intensif perbaikan bacaan (Tahsin) dan hafalan sesuai dengan kemampuan individual siswa, dipandu oleh asatidzah bersanad dan istiqomah terus di jalan para penuntut ilmu Al-Qur'an.",
    accentBg: "bg-tsls-olive-950 text-tsls-cream-50",
    borderColor: "border-tsls-olive-950"
  },
  {
    num: "02",
    title: "Character & Life Skills",
    subtitle: "الأَخْلَاقُ وَالمَهَارَاتُ الحَيَاتِيَّة",
    desc: "Melatih kemandirian, tanggung jawab atas diri sendiri, serta keterampilan praktis kehidupan sehari-hari yang membentuk pribadi kokoh dan beradab.",
    accentBg: "bg-tsls-wood-600 text-tsls-cream-50",
    borderColor: "border-tsls-wood-600"
  },
  {
    num: "03",
    title: "21st Century Skills & Islamic Science",
    subtitle: "العُلُومُ الإِسْلَامِيَّةُ وَمَهَارَاتُ العَصْر",
    desc: "Mengasah nalar kritis, kreativitas, dan kolaborasi abad 21 yang dipadukan dengan eksplorasi sains Islami berbasis tadabbur ayat-ayat kauniyah ciptaan Allah.",
    accentBg: "bg-tsls-sage-600 text-tsls-cream-50",
    borderColor: "border-tsls-sage-600"
  },
  {
    num: "04",
    title: "Leadership & Fitrah Kemandirian",
    subtitle: "القِيَادَةُ وَرِعَايَةُ الفِطْرَة",
    desc: "Fokus pada pembentukan karakter, kepemimpinan diri (self-leadership), dan tanggung jawab moral sesuai fitrah penciptaan: menumbuhkan jiwa kepemimpinan (qawwamah) dan keberanian bagi ikhwan, serta rasa malu yang mulia (haya'), kecakapan mengelola kebaikan, dan kesiapan menjadi madrasah peradaban bagi akhwat.",
    accentBg: "bg-tsls-sand-400 text-tsls-olive-950",
    borderColor: "border-tsls-sand-400"
  },
  {
    num: "05",
    title: "Persiapan Jenjang Selanjutnya",
    subtitle: "الجَاهِزِيَّةُ لِلْمَرْحَلَةِ القَادِمَة",
    desc: "Kesiapan akademik, kematangan emosi, dan keteguhan aqidah yang matang untuk transisi mulus menuju pendidikan menengah (SMP / Junior High / Pondok Pesantren).",
    accentBg: "bg-tsls-olive-800 text-tsls-cream-50",
    borderColor: "border-tsls-olive-800"
  }
];
---

<Layout title="Elementary School (PKBM Setara SD) | Tarbiyah Sunnah Lab School">

  {/* =========================================================================
      Hero Section (Academic Olive Aesthetic for Elementary)
     ========================================================================= */}
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-tsls-cream-50 overflow-hidden border-b border-tsls-olive-950/10">
    
    {/* Subtle Arabic Watermark Background */}
    <div class="absolute right-0 top-1/3 -translate-y-1/2 opacity-[0.035] pointer-events-none select-none z-0">
      <span class="arabic-watermark text-[130px] md:text-[220px] font-normal leading-none text-tsls-olive-950" dir="rtl">
        المَرْحَلَةُ الابْتِدَائِيَّة
      </span>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        
        {/* Hero Copy */}
        <div class="lg:col-span-7 space-y-8" data-reveal>
          
          <div class="flex flex-wrap items-center gap-3">
            <span class="academic-stamp text-tsls-olive-950 bg-tsls-sage-500/20 px-3 py-1 border border-tsls-sage-500/40">
              TSLS ELEMENTARY SCHOOL · ONSITE (PKBM SETARA SD)
            </span>
            <span class="text-xs font-mono text-tsls-wood-600 font-bold">
              BANDUNG
            </span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-tsls-olive-950 leading-[1.12] tracking-tight text-balance">
            Menjaga Fitrah.<br />
            <span class="italic font-serif font-normal text-tsls-wood-600">Mengembangkan Akal. Menumbuhkan Kemandirian.</span>
          </h1>

          <p class="text-base sm:text-lg text-tsls-olive-950/80 max-w-xl leading-relaxed text-pretty">
            Pendidikan dasar Islam yang mengembangkan kecakapan bahasa, kemandirian belajar, nalar kritis (*critical thinking*), dan keteguhan karakter rabbani di atas fondasi Al-Qur'an dan As-Sunnah sesuai pemahaman Salafus Shalih.
          </p>

          <div class="flex flex-wrap gap-4 pt-2">
            <a href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ size: 'lg' }), 'bg-tsls-olive-950 text-tsls-cream-50 hover:bg-tsls-olive-800 font-bold px-8 rounded-none shadow-sm')}>
              Daftar SPMB Elementary (TSLS Hub) &rarr;
            </a>
            <a href="#pilar-unggulan" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'border-tsls-olive-950 text-tsls-olive-950 hover:bg-tsls-olive-950 hover:text-tsls-cream-50 font-bold px-8 rounded-none transition-colors')}>
              Kenali Pilar Unggulan
            </a>
          </div>

          {/* Key Elementary Metrics */}
          <div class="pt-8 border-t border-tsls-olive-950/10 grid grid-cols-3 gap-4 text-left">
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Al-Qur'an</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">Tahsin Bersanad & Mutqin</div>
            </div>
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Kecakapan Abad 21</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">Sains Islami & Leadership</div>
            </div>
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Jenjang Lanjutan</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">Kesiapan SMP / Pesantren</div>
            </div>
          </div>

        </div>

        {/* Hero Photo / Visual Frame */}
        <div class="lg:col-span-5" data-reveal="fade-up">
          <div class="relative p-3 bg-tsls-cream-100 border border-tsls-olive-950/20 shadow-md">
            <div class="relative aspect-[4/5] sm:aspect-[4/3] lg:aspect-[3/4] overflow-hidden bg-tsls-cream-200">
              <img 
                src="/images/kelas.png" 
                alt="Suasana ruang belajar interaktif di Elementary TSLS" 
                class="w-full h-full object-cover grayscale-[10%] contrast-105"
                loading="eager"
              />
              <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-tsls-olive-950/85 to-transparent p-4 text-tsls-cream-50">
                <span class="text-[10px] font-mono tracking-widest uppercase text-tsls-sand-400 block">Adab Penuntut Ilmu</span>
                <p class="text-xs font-serif italic text-tsls-cream-100">Ilmu dipelajari untuk diamalkan dengan adab, keikhlasan, dan pembuktian nyata.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* =========================================================================
      Section 1 — Pilar Unggulan Pendidikan Elementary (Core Excellence)
     ========================================================================= */}
  <section id="pilar-unggulan" class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          FOKUS KEUNGGULAN INSTITUSI
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Pilar Pendidikan Elementary TSLS
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Mengokohkan pondasi ruhiyah penuntut ilmu Al-Qur'an bersanding dengan pengembangan sains, karakter kepemimpinan, dan kemandirian hidup nyata.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        {/* 01. Al-Qur'an (Tahsin & Hafalan) */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-olive-950 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4 flex flex-col justify-between" data-reveal="fade-up">
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-tsls-olive-950/10 pb-2">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-tsls-olive-950 text-tsls-cream-50">01</span>
              <span class="arabic-watermark text-xs text-tsls-olive-900/60 font-semibold">{pillars[0].subtitle}</span>
            </div>
            <h3 class="font-display font-bold text-xl text-tsls-olive-950">{pillars[0].title}</h3>
            <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
              {pillars[0].desc}
            </p>
          </div>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] font-semibold text-tsls-wood-700">
            Halaqah intensif & bimbingan talaqqi bersanad
          </div>
        </div>

        {/* 02. Character & Life Skills */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-wood-600 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4 flex flex-col justify-between" data-reveal="fade-up" style="transition-delay: 80ms">
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-tsls-olive-950/10 pb-2">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-tsls-wood-600 text-tsls-cream-50">02</span>
              <span class="arabic-watermark text-xs text-tsls-wood-700/60 font-semibold">{pillars[1].subtitle}</span>
            </div>
            <h3 class="font-display font-bold text-xl text-tsls-olive-950">{pillars[1].title}</h3>
            <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
              {pillars[1].desc}
            </p>
          </div>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] font-semibold text-tsls-wood-700">
            Pembiasaan adab keseharian & tanggung jawab diri
          </div>
        </div>

        {/* 03. 21st Century Skills & Islamic Science */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-sage-600 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4 flex flex-col justify-between" data-reveal="fade-up" style="transition-delay: 160ms">
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-tsls-olive-950/10 pb-2">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-tsls-sage-600 text-tsls-cream-50">03</span>
              <span class="arabic-watermark text-xs text-tsls-olive-900/60 font-semibold">{pillars[2].subtitle}</span>
            </div>
            <h3 class="font-display font-bold text-xl text-tsls-olive-950">{pillars[2].title}</h3>
            <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
              {pillars[2].desc}
            </p>
          </div>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] font-semibold text-tsls-wood-700">
            Tadabbur ayat kauniyah & eksperimen ilmiah
          </div>
        </div>

        {/* 04. Leadership & Fitrah Kemandirian */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-sand-400 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4 flex flex-col justify-between" data-reveal="fade-up">
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-tsls-olive-950/10 pb-2">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-tsls-sand-400 text-tsls-olive-950">04</span>
              <span class="arabic-watermark text-xs text-tsls-wood-700/60 font-semibold">{pillars[3].subtitle}</span>
            </div>
            <h3 class="font-display font-bold text-xl text-tsls-olive-950">{pillars[3].title}</h3>
            <div class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed space-y-2">
              <p>Fokus pada pembentukan karakter, kepemimpinan diri (*self-leadership*), dan tanggung jawab moral sesuai fitrah:</p>
              <ul class="space-y-1.5 pl-0.5 text-[11px] sm:text-xs">
                <li class="flex items-start gap-1.5">
                  <strong class="text-tsls-olive-950 font-bold shrink-0">• Ikhwan:</strong>
                  <span>Jiwa kepemimpinan (*qawwamah*), keberanian membela kebenaran, dan tanggung jawab pelindung.</span>
                </li>
                <li class="flex items-start gap-1.5">
                  <strong class="text-tsls-wood-700 font-bold shrink-0">• Akhwat:</strong>
                  <span>Rasa malu yang mulia (*haya'*), kecakapan mengelola kebaikan, dan kesiapan madrasah peradaban (*ummu warabbatul bayt*).</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] font-semibold text-tsls-wood-700">
            Qawwamah bagi ikhwan & Haya' peradaban bagi akhwat
          </div>
        </div>

        {/* 05. Persiapan Jenjang Selanjutnya */}
        <div class="p-8 bg-tsls-cream-50 border-t-4 border-tsls-olive-800 border-x border-b border-tsls-olive-950/15 shadow-sm space-y-4 flex flex-col justify-between lg:col-span-2" data-reveal="fade-up" style="transition-delay: 80ms">
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-tsls-olive-950/10 pb-2">
              <span class="text-xs font-mono font-bold px-2 py-0.5 bg-tsls-olive-800 text-tsls-cream-50">05 · TRANSISI</span>
              <span class="arabic-watermark text-xs text-tsls-olive-900/60 font-semibold">{pillars[4].subtitle}</span>
            </div>
            <h3 class="font-display font-bold text-xl text-tsls-olive-950">{pillars[4].title}</h3>
            <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed max-w-2xl">
              {pillars[4].desc}
            </p>
          </div>
          <div class="pt-3 border-t border-tsls-olive-950/10 text-[11px] font-semibold text-tsls-olive-800">
            Kesiapan akademik, nalar riset, dan kemandirian pondok pesantren / SMP
          </div>
        </div>

      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 2 — Enam Arah Perkembangan Murid Elementary (Radial Map)
     ========================================================================= */}
  <section id="enam-arah" class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          PETA TAHAP TUMBUH KEMBANG
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Enam Arah Perkembangan Murid Elementary
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Pendidikan dasar di TSLS tidak hanya berfokus pada penguasaan nilai ujian, melainkan menyelaraskan seluruh dimensi akal, ruhiyah, dan jasmani anak.
        </p>
      </div>

      <div data-reveal="fade-up">
        <WholeChildMap />
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 3 — Alur Kecerdasan Bahasa & Literasi (Language Spiral)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          KECERDASAN BAHASA & LITERASI
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Bahasa Sebagai Gerbang Pemahaman & Nalar
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Sebelum anak dapat berpikir kritis dan menulis karya bermutu, mereka harus melalui tangga bahasa yang kokoh dari mendengar secara beradab hingga berani menyampaikan gagasan (*Al-Bayan*).
        </p>
      </div>

      <div data-reveal="fade-up">
        <LanguageSpiral />
      </div>

      {/* Multilingual Pillar Cards */}
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-6" data-reveal="fade-up">
        <div class="p-5 bg-tsls-cream-50 border border-tsls-olive-950/15 space-y-2">
          <div class="text-xs font-mono font-bold text-tsls-olive-900">BAHASA INDONESIA</div>
          <h4 class="font-display font-bold text-base text-tsls-olive-950">Literasi Pokok</h4>
          <p class="text-xs text-tsls-olive-950/75 leading-relaxed">Tata bahasa baku, apresiasi sastra bermoral, dan kemampuan menulis naratif ilmiah.</p>
        </div>

        <div class="p-5 bg-tsls-cream-50 border border-tsls-olive-950/15 space-y-2">
          <div class="text-xs font-mono font-bold text-tsls-wood-600">BAHASA ARAB</div>
          <h4 class="font-display font-bold text-base text-tsls-olive-950">Bahasa Qur'ani</h4>
          <p class="text-xs text-tsls-olive-950/75 leading-relaxed">Pengenalan kosa kata Al-Qur'an, nahwu-sharaf aplikatif, dan percakapan tematik harian.</p>
        </div>

        <div class="p-5 bg-tsls-cream-50 border border-tsls-olive-950/15 space-y-2">
          <div class="text-xs font-mono font-bold text-tsls-sage-600">BAHASA INGGRIS</div>
          <h4 class="font-display font-bold text-base text-tsls-olive-950">Komunikasi Global</h4>
          <p class="text-xs text-tsls-olive-950/75 leading-relaxed">Keterampilan membaca teks sains, menyimak instruksi, dan presentasi lisan terarah.</p>
        </div>

        <div class="p-5 bg-tsls-cream-50 border border-tsls-olive-950/15 space-y-2">
          <div class="text-xs font-mono font-bold text-tsls-sand-500">BAHASA SUNDA</div>
          <h4 class="font-display font-bold text-base text-tsls-olive-950">Kearifan Lokal</h4>
          <p class="text-xs text-tsls-olive-950/75 leading-relaxed">Undak usuk basa Sunda yang sarat adab kesopanan, tata krama, dan budaya luhur daerah.</p>
        </div>
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 4 — Critical Thinking & Pembelajaran Mendalam (Deep Learning)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          PARADIGMA BERPIKIR
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Critical Thinking Berbasis Adab & Bukti
        </h2>
      </div>

      {/* Definition Manifesto Card */}
      <div class="p-8 md:p-12 bg-tsls-cream-100 border-l-8 border-tsls-olive-950 border-y border-r border-tsls-olive-950/15 shadow-sm max-w-4xl mx-auto space-y-4" data-reveal="fade-up">
        <span class="text-xs font-mono font-bold text-tsls-wood-600 tracking-widest uppercase block">
          DEFINISI CRITICAL THINKING DI TSLS
        </span>
        <blockquote class="font-serif italic text-lg sm:text-xl text-tsls-olive-950 leading-relaxed text-pretty">
          "Kemampuan menggunakan informasi secara cermat, membedakan fakta dan dugaan, mencari alasan dan bukti (*hujjah*), menemukan hubungan sebab-akibat, serta mengambil kesimpulan secara bertanggung jawab di atas bimbingan adab Islam."
        </blockquote>
      </div>

      {/* 3 Pillars of Deep Learning */}
      <div class="grid md:grid-cols-3 gap-8">
        
        <div class="p-6 bg-tsls-cream-100 border border-tsls-olive-950/15 space-y-3" data-reveal="fade-up">
          <div class="w-10 h-10 rounded-full bg-tsls-olive-950 text-tsls-cream-50 font-bold flex items-center justify-center font-mono text-sm">
            01
          </div>
          <h4 class="font-display font-bold text-lg text-tsls-olive-950">Berkesadaran (Conscious)</h4>
          <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
