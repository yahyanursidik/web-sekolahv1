---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ProgramCard from '../components/ui/ProgramCard.astro';
import ProgramFinder from '../components/ProgramFinder.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { PROGRAMS } from '../data/programs';
import { SITE } from '../data/constants';

const pillars = [
  {
    key: 'move',
    color: 'var(--tsls-move)',
    ink: 'var(--tsls-move-ink)',
    word: 'MOVE.',
    verb: 'Mengalami',
    line: 'Bergerak, mencoba dan bereksplorasi.',
  },
  {
    key: 'learn',
    color: 'var(--tsls-learn)',
    ink: 'var(--tsls-learn-ink)',
    word: 'LEARN.',
    verb: 'Memahami',
    line: 'Mengamati, bertanya dan menemukan makna.',
  },
  {
    key: 'grow',
    color: 'var(--tsls-grow)',
    ink: 'var(--tsls-grow-ink)',
    word: 'GROW.',
    verb: 'Bertumbuh',
    line: 'Iman, adab, ilmu dan kemandirian.',
  },
];

const philosophy = [
  {
    num: '01 / EXPERIENCE',
    word: 'MOVE.',
    color: 'var(--tsls-move-light)',
    desc: 'Anak diberi ruang untuk bergerak, bereksplorasi, mencoba, dan mengambil inisiatif melalui aktivitas nyata.',
  },
  {
    num: '02 / UNDERSTANDING',
    word: 'LEARN.',
    color: 'var(--tsls-learn-light)',
    desc: 'Belajar melalui pengalaman konkret, dialog, talaqqi, penyelidikan, praktik dan refleksi sesuai tahap usia.',
  },
  {
    num: '03 / DEVELOPMENT',
    word: 'GROW.',
    color: 'var(--tsls-grow-light)',
    desc: 'Perkembangan iman, adab, ilmu, kemandirian, sosial-emosional dan kemampuan berpikir didampingi bertahap.',
  },
];

const actionPoints = [
  {
    num: '01',
    title: 'Melihat lebih dekat.',
    desc: 'Anak mengamati lingkungan dan benda nyata sebelum mendalami konsep.',
  },
  {
    num: '02',
    title: 'Bertanya dan mencoba.',
    desc: 'Guru memancing rasa ingin tahu, lalu memberi kesempatan bereksplorasi.',
  },
  {
    num: '03',
    title: 'Memahami dan mengamalkan.',
    desc: 'Pengetahuan dihubungkan dengan adab, tanggung jawab, dan kehidupan sehari-hari.',
  },
];
---

<Layout
  title={`${SITE.name} | MOVE. LEARN. GROW.`}
  description="Tiga pilihan program, satu arah pendidikan Rabbani. TK Reguler, TK HBL, dan SD di Sekolah Tarbiyah Sunnah Bandung."
>
  {/* 1 — Hero */}
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow" data-anim>{SITE.name} · TK & SD</span>
        <h1 class="hero__title">
          <span data-anim style="--anim-delay:60ms">MOVE<span class="hero__dot--move">.</span></span>
          <span data-anim style="--anim-delay:130ms">LEARN<span class="hero__dot--learn">.</span></span>
          <span data-anim style="--anim-delay:200ms">GROW<span class="hero__dot--grow">.</span></span>
        </h1>
        <p class="hero__lead" data-anim style="--anim-delay:270ms">
          Bergerak untuk mengalami.<br />
          Belajar untuk memahami.<br />
          Bertumbuh dengan iman dan adab.
        </p>
        <p class="hero__desc" data-anim style="--anim-delay:330ms">
          Setiap anak memiliki fitrah dan tahap perkembangannya. Di Sekolah Tarbiyah Sunnah Bandung,
          Ananda didampingi melalui
          pengalaman belajar aktif, bermakna, dan menggembirakan, berlandaskan Al-Qur'an dan
          As-Sunnah sesuai pemahaman Salafus Shalih.
        </p>
        <div class="hero__actions" data-anim style="--anim-delay:390ms">
          <a class="btn btn--primary" href="/program">
            Jelajahi Program <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="btn btn--light" href="/pendekatan">
            Cara Kami Belajar <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero__proof" data-anim style="--anim-delay:450ms">
          <span>Berbasis fitrah</span>
          <span>Adab & Al-Qur'an</span>
          <span>PAUD hingga pendidikan dasar</span>
        </div>
      </div>

      <div class="hero__art">
        <div class="hero__photo" data-anim="photo" style="--anim-delay:120ms">
          <img
            src="/images/preschool/playground-outdoor.jpg"
            alt="Area bermain luar ruang Sekolah Tarbiyah Sunnah Bandung"
            width="760"
            height="900"
            fetchpriority="high"
          />
        </div>
        <div class="hero__card hero__card--top" data-anim="card-rotated" style="--anim-delay:420ms">
          <b>Learning by experience</b>
          <small>Explore · Observe · Understand</small>
        </div>
        <div class="hero__card hero__card--bottom" data-anim="card" style="--anim-delay:480ms">
          <strong>Every child,<br />a unique journey.</strong>
          <p>Didampingi bertahap. Dihargai prosesnya.</p>
        </div>
        <div class="hero__card hero__card--side" data-anim="card" style="--anim-delay:540ms">
          <b>3</b>
          <small>program belajar</small>
        </div>
      </div>
    </div>
  </section>

  {/* 2 — Three-pillar strip */}
  <div class="pillar-strip">
    <div class="container pillar-strip__inner">
      {
        pillars.map((pillar) => (
          <article>
            <div class="pillar-strip__stripe" style={`background:${pillar.color}`} />
            <div>
              <b>
                {pillar.word} <span style={`color:${pillar.ink}`}>{pillar.verb}</span>
              </b>
              <p>{pillar.line}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {/* 3 — Tiga kartu program */}
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="01 · Program"
        title="Tiga ruang belajar.<br />Satu arah pendidikan."
        desc="Pilih pengalaman belajar sesuai usia, lokasi, dan kesiapan keluarga."
      />
      <div class="program-grid">
        {PROGRAMS.map((program) => <ProgramCard program={program} />)}
      </div>
    </div>
  </section>

  {/* 4 — Philosophy in practice */}
  <section class="section belief">
    <div class="container">
      <SectionHead
        onDark
        eyebrow="02 · Filosofi dalam praktik"
        title="Bukan hanya apa yang dipelajari.<br />Tetapi bagaimana anak bertumbuh."
        desc="MOVE. LEARN. GROW. adalah pengalaman belajar, bukan sekadar slogan."
      />
      <div class="pillars">
        {
          philosophy.map((item) => (
            <article class="pillar">
              <span class="pillar__num">{item.num}</span>
              <h3 style={`color:${item.color}`}>{item.word}</h3>
              <p>{item.desc}</p>
            </article>
          ))
        }
      </div>
      <div class="foundation">
        <b>Berakar pada Tauhid, Al-Qur'an & As-Sunnah</b>
        <p>
          Seluruh program diarahkan untuk membangun generasi berkarakter Rabbani dengan pendampingan
          guru sebagai pendidik dan teladan.
        </p>
      </div>
    </div>
  </section>

  {/* 5 — Learning in action */}
  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="03 · Learning in action"
        title="Anak mengalami.<br />Guru mendampingi."
        desc="Contoh bagaimana proses belajar dibangun melalui pengalaman bermakna."
      />
      <div class="story-layout">
        <div class="story-photo">
          <img
            loading="lazy"
            src="/images/elementary-kelas-1.jpg"
            alt="Ruang kelas SD Tarbiyah Sunnah Bandung"
            width="760"
            height="860"
          />
          <div class="story-photo__overlay">
            <small>Lingkungan sekolah · {SITE.city}</small>
            <b>Ruang yang mendukung fokus, interaksi dan kemandirian.</b>
          </div>
        </div>
        <div class="story-points">
          {
            actionPoints.map((point) => (
              <div class="story-point">
                <span class="story-point__num">{point.num}</span>
                <div>
                  <strong>{point.title}</strong>
                  <p>{point.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div style="margin-top:28px">
        <a href="/cerita-belajar" class="btn btn--light">
          Lihat Kehidupan Sekolah <span class="btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  {/* 6 — Program finder */}
  <ProgramFinder />

  {/* 7 — SPMB CTA */}
  <CtaBand />
</Layout>
