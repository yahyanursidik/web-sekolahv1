---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
import { cn } from '../lib/utils';
import { EXTERNAL_LINKS } from '../data/constants';
import FitrahPath from '../components/diagrams/FitrahPath.astro';
import FoundationLayers from '../components/diagrams/FoundationLayers.astro';
import WholeChildMap from '../components/diagrams/WholeChildMap.astro';
import HomeSchoolDiagram from '../components/diagrams/HomeSchoolDiagram.astro';
import LearningFlow from '../components/diagrams/LearningFlow.astro';
---

<Layout title="Tarbiyah Sunnah Lab School | Merawat Fitrah, Membangun Generasi Rabbani">

  {/* =========================================================================
      Section 2 — Hero Section (Natural Islamic Academic)
     ========================================================================= */}
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-tsls-cream-50 overflow-hidden border-b border-tsls-olive-950/10">
    
    {/* Subtle Arabic Calligraphy Watermark in Background */}
    <div class="absolute right-0 top-1/4 -translate-y-1/2 opacity-[0.035] pointer-events-none select-none z-0">
      <span class="arabic-watermark text-[140px] md:text-[220px] lg:text-[280px] font-normal leading-none text-tsls-olive-950" dir="rtl">
        فِطْرَةَ اللَّهِ
      </span>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        
        {/* Left Column: Academic Manifesto */}
        <div class="lg:col-span-7 space-y-8" data-reveal>
          
          <div class="flex flex-wrap items-center gap-3">
            <span class="academic-stamp text-tsls-olive-950 border-b-2 border-tsls-olive-950 pb-1">
              TARBIYAH SUNNAH LAB SCHOOL · BANDUNG
            </span>
            <span class="text-xs font-mono text-tsls-wood-600 font-bold px-2 py-0.5 bg-tsls-cream-200 border border-tsls-olive-950/10">
              PRESCHOOL & ELEMENTARY
            </span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-tsls-olive-950 leading-[1.1] tracking-tight text-balance">
            Merawat Fitrah.<br />
            <span class="italic font-normal text-tsls-wood-600">Membangun Generasi Rabbani.</span>
          </h1>

          <p class="text-base sm:text-lg text-tsls-olive-950/80 max-w-xl leading-relaxed text-pretty">
            Mendampingi anak bertumbuh dengan iman, adab, ilmu, kemandirian, dan kemampuan berpikir melalui pendidikan yang sesuai tahap perkembangan, berlandaskan Al-Qur'an dan As-Sunnah sesuai pemahaman Salafus Shalih.
          </p>
          
          <div class="flex flex-wrap gap-4 pt-2">
            <a href="/tentang" class={cn(buttonVariants({ size: 'lg' }), 'bg-tsls-olive-950 text-tsls-cream-50 hover:bg-tsls-olive-800 font-bold px-8 rounded-none shadow-sm')}>
              Kenali TSLS
            </a>
            <a href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'border-tsls-olive-950 text-tsls-olive-950 hover:bg-tsls-olive-950 hover:text-tsls-cream-50 font-bold px-8 rounded-none transition-colors')}>
              Daftar SPMB (TSLS Hub) &rarr;
            </a>
          </div>

          {/* Quick Institutional Highlights */}
          <div class="pt-8 border-t border-tsls-olive-950/10 grid grid-cols-3 gap-4 text-left">
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Fondasi</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">Al-Qur'an & Sunnah</div>
            </div>
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Pendekatan</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">Sesuai Tahap Fitrah</div>
            </div>
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-tsls-wood-600 font-bold">Layanan</div>
              <div class="text-xs sm:text-sm font-bold text-tsls-olive-950 mt-0.5">3 Pilihan Program</div>
            </div>
          </div>

        </div>

        {/* Right Column: Editorial Photograph Frame */}
        <div class="lg:col-span-5" data-reveal="fade-up">
          <div class="relative p-3 bg-tsls-cream-100 border border-tsls-olive-950/20 shadow-md">
            <div class="relative aspect-[4/5] sm:aspect-[4/3] lg:aspect-[3/4] overflow-hidden bg-tsls-cream-200">
              <img 
                src="/images/kelas.png" 
                alt="Suasana pembelajaran di Tarbiyah Sunnah Lab School" 
                class="w-full h-full object-cover grayscale-[15%] contrast-110"
                loading="eager"
              />
              <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-tsls-olive-950/80 to-transparent p-4 text-tsls-cream-50">
                <span class="text-[10px] font-mono tracking-widest uppercase text-tsls-sand-400 block">Ruang Belajar TSLS</span>
                <p class="text-xs font-serif italic text-tsls-cream-100">Lingkungan alami yang tenang, memerdekakan eksplorasi & menjaga adab.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* =========================================================================
      Section 3 — Philosophy: Setiap Anak Membawa Fitrah
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {/* Header & Philosophical Manifesto */}
      <div class="grid lg:grid-cols-12 gap-12 items-start" data-reveal>
        
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
            BAB 01 · FILOSOFI PENDIDIKAN
          </div>
          
          <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 leading-tight text-balance">
            Setiap Anak Membawa Fitrah yang Perlu Dirawat
          </h2>

          <div class="p-4 bg-tsls-cream-50 border-l-4 border-tsls-wood-600 text-xs sm:text-sm text-tsls-olive-950/90 italic font-serif leading-relaxed">
            "Maka hadapkanlah wajahmu dengan lurus kepada agama Allah; (tetaplah atas) fitrah Allah yang telah menciptakan manusia menurut fitrah itu..."
            <span class="block font-sans not-italic font-bold text-[10px] text-tsls-olive-700 mt-2 font-mono uppercase">
              — QS. Ar-Rum: 30
            </span>
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6 lg:pt-8 text-base lg:text-lg text-tsls-olive-950/80 leading-relaxed text-pretty">
          <p>
            Pendidikan bukan proses mencetak atau menyeragamkan anak. Setiap anak lahir dengan tahap perkembangan, modalitas belajar, kepekaan emosi, dan potensi fitrah yang unik.
          </p>
          <p>
            TSLS berikhtiar menyediakan ilmu yang haq, keteladanan pendidik, lingkungan yang aman dari distraksi, dan pengalaman belajar konkret yang membantu fitrah itu bertumbuh mekar ke arah yang diridhai Allah Ta'ala.
          </p>
        </div>

      </div>

      {/* Animated Interactive Fitrah Growth Diagram */}
      <div data-reveal="fade-up" class="pt-4">
        <div class="text-center mb-8">
          <span class="text-[10px] font-mono uppercase tracking-widest text-tsls-olive-800 font-bold block mb-1">
            Peta Jalur Pertumbuhan Fitrah (Fitrah Growth Path)
          </span>
          <span class="text-xs text-tsls-olive-950/60 italic font-serif">
            Bagaimana TSLS mengawal proses tumbuh kembang anak dari akar keimanan hingga buah kemaslahatan
          </span>
        </div>
        <FitrahPath />
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 4 — Programs: Satu Arah Pendidikan, Tiga Pilihan Program
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="space-y-4 max-w-2xl" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          BAB 02 · PILIHAN JENJANG PENDIDIKAN
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 leading-tight">
          Satu Arah Pendidikan,<br />Tiga Pilihan Program
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Seluruh program bertumpu pada fondasi nilai yang sama, dengan modalitas pelaksanaan yang disesuaikan dengan kesiapan ananda dan keluarga.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8 items-stretch">
        
        {/* Program 1: Preschool Onsite */}
        <div class="p-8 bg-tsls-cream-100 border-t-4 border-tsls-sage-500 border-x border-b border-tsls-olive-950/15 flex flex-col justify-between group hover:shadow-md transition-all" data-reveal="fade-up">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold tracking-widest uppercase text-tsls-olive-800 bg-tsls-sage-500/20 px-2.5 py-1">
                ONSITE · USIA 3–6 TAHUN
              </span>
              <span class="arabic-watermark text-sm text-tsls-olive-950/40">رَوْضَةُ الأَطْفَال</span>
            </div>

            <h3 class="font-display text-2xl font-bold text-tsls-olive-950 group-hover:text-tsls-wood-700 transition-colors">
              Preschool
            </h3>

            <p class="text-sm text-tsls-olive-950/80 leading-relaxed text-pretty">
              Pengalaman belajar yang hangat, konkret, dan sesuai tahap perkembangan untuk membangun iman, adab, kemandirian, bahasa, sosial-emosional, dan kesiapan belajar.
            </p>

            <div class="pt-4 border-t border-tsls-olive-950/10 space-y-2 text-xs text-tsls-olive-950/75">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-tsls-sage-500"></span>
                <span>Sentra bermain konkret & eksplorasi sensorik</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-tsls-sage-500"></span>
                <span>Tahfidz Juz 'Amma bertahap & hadits pilihan</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-tsls-sage-500"></span>
                <span>Pembiasaan adab harian, cinta keluarga & sesama</span>
              </div>
            </div>
          </div>

          <a href="/preschool" class="inline-flex items-center gap-2 text-xs font-bold text-tsls-olive-950 uppercase tracking-widest hover:text-tsls-wood-600 mt-8 pt-4 border-t border-tsls-olive-950/10 transition-colors">
            Jelajahi Preschool &rarr;
          </a>
        </div>

        {/* Program 2: Preschool HBL */}
        <div class="p-8 bg-tsls-cream-100 border-t-4 border-tsls-sand-400 border-x border-b border-tsls-olive-950/15 flex flex-col justify-between group hover:shadow-md transition-all" data-reveal="fade-up" style="transition-delay: 120ms">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold tracking-widest uppercase text-tsls-wood-600 bg-tsls-sand-400/30 px-2.5 py-1">
                HOME-BASED LEARNING
              </span>
              <span class="arabic-watermark text-sm text-tsls-olive-950/40">تَعَلُّمٌ مَنْزِلِيّ</span>
            </div>

            <h3 class="font-display text-2xl font-bold text-tsls-olive-950 group-hover:text-tsls-wood-700 transition-colors">
              Preschool dari Rumah
            </h3>

            <p class="text-sm text-tsls-olive-950/80 leading-relaxed text-pretty">
              Kurikulum dan pendampingan terarah dari guru TSLS untuk memandu orang tua menghadirkan pembelajaran usia dini tanpa mengubah rumah menjadi ruang kelas formal yang kaku.
            </p>

            <div class="pt-4 border-t border-tsls-olive-950/10 space-y-2 text-xs text-tsls-olive-950/75">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-tsls-wood-600"></span>
                <span>Modul aktivitas mingguan terstruktur</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-tsls-wood-600"></span>
                <span>Konsultasi & supervisi rutin bersama guru</span>
              </div>
            </div>
          </div>

          <a href="/preschool-hbl" class="inline-flex items-center gap-2 text-xs font-bold text-tsls-olive-950 uppercase tracking-widest hover:text-tsls-wood-600 mt-8 pt-4 border-t border-tsls-olive-950/10 transition-colors">
            Jelajahi Preschool HBL &rarr;
          </a>
        </div>

        {/* Program 3: Elementary School */}
        <div class="p-8 bg-tsls-cream-100 border-t-4 border-tsls-olive-950 border-x border-b border-tsls-olive-950/15 flex flex-col justify-between group hover:shadow-md transition-all" data-reveal="fade-up" style="transition-delay: 240ms">
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-mono font-bold tracking-widest uppercase text-tsls-cream-50 bg-tsls-olive-950 px-2.5 py-1">
                ONSITE · PKBM SETARA SD
              </span>
              <span class="arabic-watermark text-sm text-tsls-olive-950/40">مَرْحَلَةٌ ابْتِدَائِيَّة</span>
            </div>

            <h3 class="font-display text-2xl font-bold text-tsls-olive-950 group-hover:text-tsls-wood-700 transition-colors">
              Elementary School
            </h3>

            <p class="text-sm text-tsls-olive-950/80 leading-relaxed text-pretty">
              Pendidikan dasar yang mengembangkan bahasa, sosial-emosional, kognitif, critical thinking, kemandirian, dan kebiasaan belajar di atas fondasi Al-Qur'an dan Sunnah.
            </p>

            <div class="pt-4 border-t border-tsls-olive-950/10 space-y-2 text-xs text-tsls-olive-950/75">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-tsls-olive-950"></span>
                <span>Integrasi sains, matematika, & adab Islam</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-tsls-olive-950"></span>
                <span>Pembiasaan critical thinking & proyek nyata</span>
              </div>
            </div>
          </div>

          <a href="/elementary" class="inline-flex items-center gap-2 text-xs font-bold text-tsls-olive-950 uppercase tracking-widest hover:text-tsls-wood-600 mt-8 pt-4 border-t border-tsls-olive-950/10 transition-colors">
            Jelajahi Elementary &rarr;
          </a>
        </div>

      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 5 — Foundation: Berbeda Tahap, Satu Fondasi
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-12">
      
      <div class="space-y-6" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          BAB 03 · ARSITEKTUR INTEGRASI KURIKULUM
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Berbeda Tahap, Satu Fondasi
        </h2>
        <p class="text-base sm:text-lg text-tsls-olive-950/80 max-w-2xl mx-auto text-balance leading-relaxed">
          Dari Preschool hingga Elementary, arah pendidikan tetap bertumpu pada fondasi yang sama. Islam bukan sekadar mata pelajaran tambahan, melainkan poros yang mengarahkan seluruh ilmu dan amal.
        </p>
      </div>

      <div data-reveal="fade-up">
        <FoundationLayers />
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 6 — Child Development: Whole Child Map
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10 overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-6 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          BAB 04 · ENAM DOMAIN PERKEMBANGAN UTUH
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Kami Tidak Hanya Bertanya,<br />
          <span class="italic font-serif font-normal text-tsls-wood-600">"Apa yang Anak Tahu?"</span>
        </h2>
        <p class="text-base sm:text-lg text-tsls-olive-950/80 max-w-3xl mx-auto text-pretty leading-relaxed">
          Kami juga memperhatikan bagaimana anak memahami dirinya, berkomunikasi dengan santun, mengelola emosi, mengambil tanggung jawab, berpikir kritis, dan mengamalkan ilmu dalam keseharian.
        </p>
      </div>

      <div data-reveal="fade-up">
        <WholeChildMap />
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 7 — How Learning Works (Spiral of Learning)
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-16 lg:gap-12 items-start">
        
        {/* Left Column: 7-Step Animated Learning Flow */}
        <div class="lg:col-span-5 space-y-6" data-reveal>
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
            BAB 05 · SPIRAL METODE PEMBELAJARAN
          </div>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-tsls-olive-950 leading-tight text-balance">
            Belajar untuk Memahami,<br />
            <span class="italic font-serif font-normal text-tsls-wood-600">Bukan Sekadar Menghafal Materi</span>
          </h2>
          
          <div class="pt-4">
            <LearningFlow />
          </div>
        </div>

        {/* Right Column: 3 Pedagogical Principles */}
        <div class="lg:col-span-7 space-y-8 lg:pl-6">
          <div class="border-b border-tsls-olive-950/10 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-tsls-olive-700 font-bold">
              3 Prinsip Pedagogi TSLS
            </span>
          </div>

          <div class="space-y-6">
            <div class="p-6 bg-tsls-cream-50 border border-tsls-olive-950/15" data-reveal="fade-up">
              <div class="flex items-center justify-between mb-2">
                <h4 class="font-display font-bold text-xl text-tsls-olive-950">01. Berkesadaran</h4>
                <span class="text-xs font-mono text-tsls-wood-600 font-bold">AL-WA'YU</span>
              </div>
              <p class="text-sm text-tsls-olive-950/80 leading-relaxed text-pretty">
                Anak mengetahui apa yang sedang dipelajari dan secara bertahap memahami tujuan belajarnya. Pembelajaran tidak berlangsung dengan paksaan atau kepatuhan buta, melainkan melalui keterlibatan nalar yang sadar.
              </p>
            </div>

            <div class="p-6 bg-tsls-cream-50 border border-tsls-olive-950/15" data-reveal="fade-up" style="transition-delay: 100ms">
              <div class="flex items-center justify-between mb-2">
                <h4 class="font-display font-bold text-xl text-tsls-olive-950">02. Bermakna</h4>
                <span class="text-xs font-mono text-tsls-wood-600 font-bold">AL-MA'NAWIYYAH</span>
              </div>
              <p class="text-sm text-tsls-olive-950/80 leading-relaxed text-pretty">
                Konsep tidak berhenti sebagai teori abstrak di atas kertas; anak menghubungkannya dengan pengalaman indrawi, fenomena alam ciptaan Allah, dan aplikasi konkret dalam kehidupannya.
              </p>
            </div>

            <div class="p-6 bg-tsls-cream-50 border border-tsls-olive-950/15" data-reveal="fade-up" style="transition-delay: 200ms">
              <div class="flex items-center justify-between mb-2">
                <h4 class="font-display font-bold text-xl text-tsls-olive-950">03. Menggembirakan</h4>
                <span class="text-xs font-mono text-tsls-wood-600 font-bold">AL-INSHIRAH</span>
              </div>
              <p class="text-sm text-tsls-olive-950/80 leading-relaxed text-pretty">
                Belajar berlangsung dalam suasana yang lapang, menghargai proses ikhtiar anak, dan tetap memberikan tantangan yang sesuai tanpa menimbulkan stres yang mematikan kecintaan pada ilmu.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* =========================================================================
      Section 8 — Parent Partnership: Sinergi Rumah & Sekolah
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-12">
      
      <div class="space-y-6" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          BAB 06 · SINERGI KELUARGA & MADRASAH
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance">
          Sekolah Tidak Menggantikan Rumah
        </h2>
        <p class="text-base sm:text-lg text-tsls-olive-950/80 max-w-2xl mx-auto text-balance leading-relaxed">
