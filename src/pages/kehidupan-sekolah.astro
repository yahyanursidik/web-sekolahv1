---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
import { cn } from '../lib/utils';
import { EXTERNAL_LINKS } from '../data/constants';

interface ClassroomSpot {
  img: string;
  badge: string;
  title: string;
  desc: string;
}

const elementaryClassrooms: ClassroomSpot[] = [
  {
    img: "/images/elementary-kelas-1.jpg",
    badge: "FOKUS AKADEMIK & ADAB",
    title: "Tata Letak Meja & Papan Tulis Majelis",
    desc: "Ruang kelas berpendingin udara yang bersih dan rapi, dilengkapi papan tulis interaktif, materi alfabet multiliterasi, dan pengingat adab penuntut ilmu di dinding kelas."
  },
  {
    img: "/images/elementary-kelas-2.jpg",
    badge: "PARTISI ADAB & MULTIMEDIA",
    title: "Sekat Partisi Kayu & Layar Edukasi",
    desc: "Dilengkapi partisi kayu fleksibel untuk pemisahan adab yang santun, fasilitas layar presentasi visual, serta area transisi lantai kayu yang nyaman."
  },
  {
    img: "/images/elementary-kelas-3.jpg",
    badge: "INTERAKSI & DISPLAY KARYA",
    title: "Formasi Belajar Interaktif & Karya Murid",
    desc: "Susunan meja-kursi ergonomis yang mendukung konsentrasi mandiri maupun kerja kelompok musyawarah, dihiasi display kreasi visual buatan anak."
  },
  {
    img: "/images/elementary-halaqah.jpg",
    badge: "HALAQAH & PEMBIASAAN ADAB",
    title: "Pojok Halaqah Karpet & Kerapian Diri",
    desc: "Area karpet permadani untuk dzikir ma'tsurat pagi, halaqah talaqqi Al-Qur'an, cermin kerapian berpakaian, serta poster panduan adab islami harian."
  }
];

const dailyCultures = [
  {
    num: "01",
    title: "Dzikir Pagi & Pembuka Hati",
    desc: "Mengawali hari dengan doa, dzikir ma'tsurat bersama, dan pengkondisian hati agar bersih menyambut curahan ilmu."
  },
  {
    num: "02",
    title: "Adab Majelis & Tanggung Jawab Diri",
    desc: "Membiasakan murid merapikan loker, mengangkat kursi saat selesai belajar, dan menjaga kebersihan ruang bersama."
  },
  {
    num: "03",
    title: "Shalat Zhuhur Berjamaah di Masjid",
    desc: "Khusus ikhwan dibina berjalan beradab menuju masjid untuk shalat berjamaah, melatih wibawa dan kedisiplinan sejak dini."
  },
  {
    num: "04",
    title: "Makan Sehat & Sosialisasi Hangat",
    desc: "Menikmati kudapan dan makan siang dengan mempraktikkan sunnah nabi (duduk, tangan kanan, basmalah, dan bersyukur)."
  }
];
---

<Layout title="Kehidupan Sekolah | Tarbiyah Sunnah Lab School">

  {/* =========================================================================
      Hero Section (Kehidupan Sekolah)
     ========================================================================= */}
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 bg-tsls-cream-50 overflow-hidden border-b border-tsls-olive-950/10">
    
    {/* Subtle Arabic Watermark Background */}
    <div class="absolute right-0 top-1/3 -translate-y-1/2 opacity-[0.03] pointer-events-none select-none z-0">
      <span class="arabic-watermark text-[140px] md:text-[240px] font-normal leading-none text-tsls-olive-950" dir="rtl">
        الحَيَاةُ المَدْرَسِيَّة
      </span>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 relative z-10" data-reveal>
      <div class="inline-flex items-center gap-2 px-3.5 py-1 bg-tsls-sage-500/20 border border-tsls-sage-500/40 text-tsls-olive-950 text-xs font-mono font-bold tracking-widest uppercase">
        RUANG BELAJAR & EKOSISTEM ADAB
      </div>
      
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-tsls-olive-950 leading-[1.12] tracking-tight text-balance">
        Kehidupan Sekolah yang Tenang, Bersih, dan Sarat Nilai Adab.
      </h1>

      <p class="text-base sm:text-lg text-tsls-olive-950/80 leading-relaxed max-w-3xl mx-auto text-pretty">
        Setiap sudut ruang kelas dan lingkungan di Tarbiyah Sunnah Lab School dirancang untuk menghadirkan ketenangan jiwa, memuliakan penuntut ilmu, dan menumbuhkan kemandirian anak dalam suasana islami yang hangat.
      </p>

      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a href="#kelas-elementary" class={cn(buttonVariants({ size: 'lg' }), 'bg-tsls-olive-950 text-tsls-cream-50 hover:bg-tsls-olive-800 font-bold px-8 rounded-none shadow-sm')}>
          Lihat Kelas Elementary School &rarr;
        </a>
        <a href="/kontak" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'border-tsls-olive-950 text-tsls-olive-950 hover:bg-tsls-olive-950 hover:text-tsls-cream-50 font-bold px-8 rounded-none transition-colors')}>
          Jadwalkan Visitasi
        </a>
      </div>
    </div>
  </section>

  {/* =========================================================================
      Section 1 — Ruang Kelas Elementary School (PKBM Setara SD)
     ========================================================================= */}
  <section id="kelas-elementary" class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="space-y-4 max-w-3xl" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          FASILITAS ELEMENTARY SCHOOL
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 leading-tight">
          Ruang Belajar Elementary School (PKBM Setara SD)
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Ruang kelas berpendingin udara (AC) yang sejuk, bersih, dan terang dengan penataan meja modular yang fleksibel untuk pembelajaran mandiri, proyek kelompok, hingga majelis talaqqi Al-Qur'an.
        </p>
      </div>

      {/* 4-Card Photo Gallery Grid with High-Contrast Framing */}
      <div class="grid md:grid-cols-2 gap-8">
        {elementaryClassrooms.map((room, idx) => (
          <div 
            class="p-4 bg-tsls-cream-50 border border-tsls-olive-950/20 shadow-md space-y-4 flex flex-col justify-between"
            data-reveal="fade-up"
            style={`transition-delay: ${idx * 80}ms`}
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-tsls-cream-200 group">
              <img 
                src={room.img} 
                alt={room.title} 
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
              
              {/* High-Contrast Top Badge */}
              <div class="absolute top-3 left-3 z-10">
                <span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-bold tracking-wider uppercase px-3 py-1 bg-tsls-olive-950 text-tsls-cream-50 shadow-md border border-tsls-sand-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-tsls-sand-400 animate-pulse"></span>
                  {room.badge}
                </span>
              </div>
            </div>

            <div class="p-2 space-y-1.5">
              <h3 class="font-display font-bold text-xl text-tsls-olive-950 leading-snug">
                {room.title}
              </h3>
              <p class="text-xs sm:text-sm text-tsls-olive-950/80 leading-relaxed">
                {room.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 2 — Area Outdoor & Bermain Preschool
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-50 border-b border-tsls-olive-950/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="grid lg:grid-cols-12 gap-12 items-center" data-reveal>
        
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
            FASILITAS PRESCHOOL
          </div>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-tsls-olive-950 leading-tight">
            Area Bermain Luar Ruang & Motorik Kasar
          </h2>
          <p class="text-base text-tsls-olive-950/80 leading-relaxed text-pretty">
            Area luar ruang beralaskan rumput sintetis aman dilengkapi perosotan, ayunan, dan zona eksplorasi bahan alam yang dirancang untuk melatih ketangkasan fisik, koordinasi motorik, dan kebahagiaan anak usia dini.
          </p>
          
          <div class="space-y-3 pt-2">
            <div class="p-3.5 bg-tsls-cream-100 border border-tsls-olive-950/15">
              <span class="text-xs font-bold text-tsls-olive-950 block mb-0.5">Stimulasi Sensorik Alami</span>
              <span class="text-xs text-tsls-olive-950/75">Mendapatkan asupan sinar matahari pagi dan udara segar yang mendukung kesehatan fisik ananda.</span>
            </div>
            <div class="p-3.5 bg-tsls-cream-100 border border-tsls-olive-950/15">
              <span class="text-xs font-bold text-tsls-olive-950 block mb-0.5">Sosialisasi Positif & Bergantian</span>
              <span class="text-xs text-tsls-olive-950/75">Membiasakan budaya antre, berbagi mainan, dan saling peduli terhadap teman sebaya.</span>
            </div>
          </div>

          <div class="pt-2">
            <a href="/preschool" class="inline-flex items-center gap-1.5 text-xs font-bold text-tsls-olive-950 hover:text-tsls-wood-600 transition-colors uppercase tracking-wider">
              Lihat Program Preschool Onsite &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-6" data-reveal="fade-up">
          <div class="p-3 bg-tsls-cream-100 border border-tsls-olive-950/20 shadow-md">
            <div class="relative aspect-[4/3] overflow-hidden bg-tsls-cream-200 group">
              <img 
                src="/images/preschool-outdoor.jpg" 
                alt="Area Bermain Outdoor Preschool TSLS" 
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute top-3 left-3 z-10">
                <span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-bold tracking-wider uppercase px-3 py-1 bg-tsls-olive-950 text-tsls-cream-50 shadow-md border border-tsls-sand-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-tsls-sand-400 animate-pulse"></span>
                  PLAYGROUND OUTDOOR PRESCHOOL
                </span>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 3 — Nilai Keseharian & Budaya Sekolah
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-cream-100 border-b border-tsls-olive-950/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center space-y-4 max-w-3xl mx-auto" data-reveal>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-tsls-wood-600 border-b border-tsls-wood-600/30 pb-1">
          BUDAYA INSTITUSI
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-tsls-olive-950 text-balance leading-tight">
          Empat Pilar Pembiasaan Harian
        </h2>
        <p class="text-base text-tsls-olive-950/80 leading-relaxed">
          Pendidikan sejati bukan hanya apa yang tertulis di buku cetak, melainkan adab yang hidup dan dipraktikkan sepanjang hari di sekolah.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {dailyCultures.map((c, idx) => (
          <div 
            class="p-6 bg-tsls-cream-50 border border-tsls-olive-950/15 shadow-sm space-y-3 flex flex-col justify-between"
            data-reveal="fade-up"
            style={`transition-delay: ${idx * 80}ms`}
          >
            <div class="space-y-3">
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 bg-tsls-olive-950 text-tsls-cream-50 inline-block">
                {c.num}
              </span>
              <h4 class="font-display font-bold text-lg text-tsls-olive-950 leading-snug">
                {c.title}
              </h4>
              <p class="text-xs text-tsls-olive-950/80 leading-relaxed">
                {c.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* =========================================================================
      Section 4 — CTA Visitasi & SPMB
     ========================================================================= */}
  <section class="py-24 md:py-32 bg-tsls-olive-950 text-tsls-cream-50 text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-8" data-reveal>
      <span class="text-xs font-mono uppercase tracking-widest text-tsls-sand-400 font-bold block">
        VISITASI & KONSULTASI PENDIDIKAN
      </span>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold">
        Rasakan Langsung Kehangatan Sekolah Kami
      </h2>
      <p class="text-base sm:text-lg text-tsls-cream-100/80 leading-relaxed text-pretty">
        Ayah dan Bunda dipersilakan untuk menjadwalkan kunjungan langsung ke kampus TSLS, melihat fasilitas kelas, dan berdiskusi seputar pendidikan ananda.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a href="/kontak" class={cn(buttonVariants({ size: 'lg' }), 'bg-tsls-cream-50 text-tsls-olive-950 hover:bg-tsls-cream-200 font-bold px-10 rounded-none shadow-md')}>
          Jadwalkan Kunjungan (Visitasi) &rarr;
        </a>
        <a href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'border-tsls-sand-400 text-tsls-sand-400 hover:bg-tsls-sand-400 hover:text-tsls-olive-950 font-bold px-10 rounded-none transition-colors')}>
          Pendaftaran SPMB Online
        </a>
      </div>
    </div>
  </section>

</Layout>
