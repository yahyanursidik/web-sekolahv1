---
import { EXTERNAL_LINKS, SITE, SPMB } from '../data/constants';
import { PROGRAMS } from '../data/programs';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__main">
      <div>
        <a class="brand" href="/" aria-label={`${SITE.name} — Beranda`}>
          <img class="brand__logo" src="/images/logo.png" alt={SITE.name} width="723" height="240" />
        </a>
        <p class="site-footer__desc">
          Mendampingi setiap anak bergerak, belajar, dan bertumbuh dalam iman, adab, ilmu, serta
          kemandirian. Membangun Generasi Berkarakter Rabbani.
        </p>
        <p class="site-footer__desc">{SITE.address}</p>
      </div>

      <div>
        <h4>Program</h4>
        <div class="site-footer__links">
          {PROGRAMS.map((program) => <a href={`/program/${program.slug}`}>{program.shortName}</a>)}
          <a href="/program">Bandingkan Program</a>
        </div>
      </div>

      <div>
        <h4>Jelajahi</h4>
        <div class="site-footer__links">
          <a href="/pendekatan">Cara Belajar</a>
          <a href="/cerita-belajar">Kehidupan Sekolah</a>
          <a href="/tentang">Tentang Sekolah</a>
          <a href="/faq">Pertanyaan Umum</a>
        </div>
      </div>

      <div>
        <h4>Terhubung</h4>
        <div class="site-footer__links">
          <a href="/spmb">{SPMB.label}</a>
          <a href="/kontak">Kontak & Lokasi</a>
          <a href={EXTERNAL_LINKS.consultation} target="_blank" rel="noopener">School Center</a>
          <a href={EXTERNAL_LINKS.portal} target="_blank" rel="noopener">Portal Orang Tua ↗</a>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {currentYear} {SITE.name}. Hak cipta dilindungi.</span>
      <span>{SITE.city} · tslabschool.sch.id</span>
    </div>
  </div>
</footer>
