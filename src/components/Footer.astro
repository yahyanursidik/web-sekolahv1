---
import { EXTERNAL_LINKS } from '../data/constants';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="space-y-3">
      <a href="/" class="inline-block" aria-label="Tarbiyah Sunnah Lab School">
        <img src="/images/logo-white.svg" alt="Tarbiyah Sunnah Lab School" class="h-10 w-auto object-contain mb-1" width="200" height="45" />
      </a>
      <p class="text-sm text-color-paper/80 leading-relaxed">
        Merawat Fitrah, Membangun Generasi Rabbani. Mendampingi anak bertumbuh dengan iman, adab, ilmu, dan karakter rabbani di atas fondasi Al-Qur'an dan As-Sunnah.
      </p>
      <a href="/tentang" class="text-sm font-bold inline-flex items-center gap-1 hover:underline">
        Kenali sekolah kami <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div>
      <h4 class="font-bold text-base mb-4 text-color-paper">Program</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/preschool" class="hover:underline">Preschool</a></li>
        <li><a href="/preschool-hbl" class="hover:underline">Preschool HBL</a></li>
        <li><a href="/elementary" class="hover:underline">Elementary (SD IT)</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-base mb-4 text-color-paper">Informasi</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/tentang" class="hover:underline">Tentang TSLS</a></li>
        <li><a href="/pendidikan" class="hover:underline">Pendidikan di TSLS</a></li>
        <li><a href="/kehidupan-sekolah" class="hover:underline">Kehidupan Sekolah</a></li>
        <li><a href="/spmb" class="hover:underline">SPMB</a></li>
        <li><a href="/faq" class="hover:underline">FAQ</a></li>
        <li><a href="/kontak" class="hover:underline">Kontak</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-base mb-4 text-color-paper">Akses & Hubungan</h4>
      <ul class="space-y-2 text-sm mb-6">
        <li>
          <a href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener noreferrer" class="font-bold text-warm-soft hover:underline">
            TSLS Hub Portal &rarr;
          </a>
        </li>
        <li>
          <a href="https://wa.me/6285173396002" target="_blank" rel="noopener noreferrer" class="hover:underline">
            WhatsApp Admin
          </a>
        </li>
        <li>
          <a href="https://maps.google.com/?q=Tarbiyah+Sunnah+Lab+School+Bandung" target="_blank" rel="noopener noreferrer" class="hover:underline">
            Lokasi Maps
          </a>
        </li>
      </ul>
      <div class="text-xs text-color-paper/70">
        Jl. Setrasari VI No.3A, Sukarasa, Kec. Sukasari, Kota Bandung, Jawa Barat 40152
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <span>&copy; {currentYear} Tarbiyah Sunnah Lab School (TSLS). Hak cipta dilindungi.</span>
    <span>Bandung, Jawa Barat</span>
  </div>
</footer>
