---
// AdventureMap.astro
// Komponen animasi peta pendidikan dengan tema STEAM (Science, Technology, Engineering, Arts, Mathematics) yang colorful
---

<div class="relative w-full h-full bg-[#f8fafc] rounded-lg overflow-hidden flex items-center justify-center p-8 group/map border border-slate-200 shadow-inner">
  
  <!-- Blueprint/Engineering Grid Background -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: 
    linear-gradient(#64748b 1px, transparent 1px),
    linear-gradient(90deg, #64748b 1px, transparent 1px); 
    background-size: 40px 40px;">
  </div>
  <!-- Sub-grid -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: 
    linear-gradient(#64748b 1px, transparent 1px),
    linear-gradient(90deg, #64748b 1px, transparent 1px); 
    background-size: 10px 10px;">
  </div>

  <!-- STEAM Elements Background SVG -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice">
    <defs>
      <!-- Colorful Gradient for the Journey Path -->
      <linearGradient id="steam-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#f43f5e" /> <!-- Pink (Arts) -->
        <stop offset="25%" stop-color="#a855f7" /> <!-- Purple (Tech) -->
        <stop offset="50%" stop-color="#3b82f6" /> <!-- Blue (Science) -->
        <stop offset="75%" stop-color="#10b981" /> <!-- Green (Math) -->
        <stop offset="100%" stop-color="#f97316" /> <!-- Orange (Engineering) -->
      </linearGradient>
    </defs>

    <!-- Science: Atom structure (Blue) -->
    <g class="text-blue-500/20" transform="translate(150, 150) scale(1.5)">
      <circle cx="0" cy="0" r="8" fill="currentColor"/>
      <g class="spin-element" style="transform-origin: 0 0;">
        <ellipse cx="0" cy="0" rx="40" ry="15" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(30)"/>
        <ellipse cx="0" cy="0" rx="40" ry="15" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(90)"/>
        <ellipse cx="0" cy="0" rx="40" ry="15" fill="none" stroke="currentColor" stroke-width="2" transform="rotate(150)"/>
      </g>
    </g>

    <!-- Engineering: Gears (Orange) -->
    <g class="text-orange-500/20" transform="translate(850, 450) scale(2)">
      <g class="spin-element-reverse" style="transform-origin: 0 0;">
        <circle cx="0" cy="0" r="25" fill="none" stroke="currentColor" stroke-width="8" stroke-dasharray="10 6"/>
        <circle cx="0" cy="0" r="18" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="0" cy="0" r="6" fill="currentColor"/>
      </g>
    </g>

    <!-- Arts: Golden Ratio / Geometry (Pink) -->
    <g class="text-pink-500/20" transform="translate(800, 150) scale(1.2)">
      <path d="M 0,0 A 20,20 0 0 1 20,20 A 40,40 0 0 1 -20,60 A 80,80 0 0 1 -100,-20 A 160,160 0 0 1 60,-180" fill="none" stroke="currentColor" stroke-width="2"/>
      <rect x="-20" y="20" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <rect x="-100" y="-20" width="80" height="80" fill="none" stroke="currentColor" stroke-width="1.5"/>
    </g>
    
    <!-- Math: Geometric Polyhedron (Green) -->
    <g class="text-green-500/20" transform="translate(200, 500) scale(1.5)">
      <polygon points="0,-40 35,-20 35,20 0,40 -35,20 -35,-20" fill="none" stroke="currentColor" stroke-width="2"/>
      <line x1="0" y1="-40" x2="0" y2="40" stroke="currentColor" stroke-width="1"/>
      <line x1="-35" y1="-20" x2="35" y2="20" stroke="currentColor" stroke-width="1"/>
      <line x1="-35" y1="20" x2="35" y2="-20" stroke="currentColor" stroke-width="1"/>
    </g>

    <!-- Technology: Circuit Board Traces (Purple) -->
    <g class="text-purple-500/30" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M 50,300 L 150,300 L 200,250 L 200,200"/>
      <circle cx="50" cy="300" r="4" fill="currentColor"/>
      <circle cx="200" cy="200" r="4" fill="currentColor"/>
      
      <path d="M 400,550 L 400,500 L 500,400 L 550,400"/>
      <circle cx="400" cy="550" r="4" fill="currentColor"/>
      <circle cx="550" cy="400" r="4" fill="currentColor"/>
      
      <path d="M 650,50 L 650,100 L 550,200 L 500,200"/>
      <circle cx="650" cy="50" r="4" fill="currentColor"/>
    </g>

    <!-- Main Circuit Path (The Journey) -->
    <path id="journey-path" d="M 100,450 L 300,450 L 300,350 L 500,350 L 500,250 L 700,250 L 700,150 L 900,150" 
          fill="none" 
          class="stroke-slate-300 opacity-50" 
          stroke-width="8" 
          stroke-linejoin="round"
          stroke-linecap="round"/>
          
    <!-- Animated Active Circuit Path with Colorful Gradient -->
    <path d="M 100,450 L 300,450 L 300,350 L 500,350 L 500,250 L 700,250 L 700,150 L 900,150" 
          fill="none" 
          stroke="url(#steam-gradient)" 
          class="adventure-path-animated drop-shadow-md" 
          stroke-width="8" 
          stroke-linejoin="round"
          stroke-linecap="round" />
  </svg>
  
  <!-- Nodes (Educational Stages) -->
  
  <!-- Node 1: Preschool (Creativity & Arts - Pink) -->
  <div class="absolute group cursor-pointer z-20" style="left: 30%; top: 75%; transform: translate(-50%, -50%);">
    <div class="relative z-10 w-16 h-16 bg-white rounded-full border-4 border-pink-500 shadow-lg shadow-pink-500/30 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
      <span class="material-symbols-outlined text-pink-500 text-3xl">palette</span>
    </div>
    <div class="absolute -top-14 left-1/2 -translate-x-1/2 bg-pink-500 text-white px-4 py-2 rounded-lg text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap shadow-md pointer-events-none">
      Preschool (PAUD)
      <div class="absolute bottom-[-6px] left-1/2 -translate-x-1/2 border-l-8 border-r-8 border-t-8 border-transparent border-t-pink-500"></div>
    </div>
    <div class="absolute inset-0 bg-pink-500 rounded-full animate-ping opacity-30"></div>
  </div>

  <!-- Node 2: Elementary (Science & Tech - Blue) -->
  <div class="absolute group cursor-pointer z-20" style="left: 70%; top: 41.6%; transform: translate(-50%, -50%);">
    <div class="relative z-10 w-20 h-20 bg-white rounded-full border-4 border-blue-500 shadow-lg shadow-blue-500/30 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
      <span class="material-symbols-outlined text-blue-500 text-4xl">science</span>
    </div>
    <div class="absolute -top-14 left-1/2 -translate-x-1/2 bg-blue-500 text-white px-4 py-2 rounded-lg text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap shadow-md pointer-events-none">
      Elementary (SD)
      <div class="absolute bottom-[-6px] left-1/2 -translate-x-1/2 border-l-8 border-r-8 border-t-8 border-transparent border-t-blue-500"></div>
    </div>
    <div class="absolute inset-0 bg-blue-500 rounded-full animate-ping opacity-30" style="animation-delay: 0.5s;"></div>
  </div>
  
  <!-- Moving Character (Technology / Microchip - Purple) -->
  <div class="absolute w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-lg shadow-purple-500/50 text-purple-500 z-30 adventure-character border-4 border-purple-500">
    <span class="material-symbols-outlined text-2xl">memory</span>
  </div>
  
  <!-- Map Legend / Decoration -->
  <div class="absolute bottom-4 right-4 bg-white/90 backdrop-blur-sm p-3 rounded-lg border border-slate-200 shadow-sm flex items-center gap-3">
    <div class="flex gap-1">
      <div class="w-3 h-3 rounded-full bg-blue-500" title="Science"></div>
      <div class="w-3 h-3 rounded-full bg-purple-500" title="Technology"></div>
      <div class="w-3 h-3 rounded-full bg-orange-500" title="Engineering"></div>
      <div class="w-3 h-3 rounded-full bg-pink-500" title="Arts"></div>
      <div class="w-3 h-3 rounded-full bg-green-500" title="Mathematics"></div>
    </div>
    <div class="text-xs font-bold text-slate-600 border-l border-slate-300 pl-3">
      STEAM Journey
    </div>
  </div>
</div>

<style>
  /* SVG Path Animation */
  .adventure-path-animated {
    stroke-dasharray: 1500;
    stroke-dashoffset: 1500;
    animation: drawPath 4s ease-out forwards;
  }
  
  .group\/map:hover .adventure-path-animated {
    animation: drawPath 4s ease-out forwards, glowPath 2s ease-in-out infinite alternate;
  }

  @keyframes drawPath {
    to {
      stroke-dashoffset: 0;
    }
  }
  
  @keyframes glowPath {
    from { filter: drop-shadow(0 0 2px rgba(168, 85, 247, 0.4)); }
    to { filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.8)); }
  }

  /* Character motion along SVG path */
  .adventure-character {
    offset-path: path('M 100,450 L 300,450 L 300,350 L 500,350 L 500,250 L 700,250 L 700,150 L 900,150');
    offset-rotate: auto; /* Rotation follows the path naturally */
    animation: moveCharacter 8s ease-in-out infinite alternate;
  }

  @keyframes moveCharacter {
    0% {
      offset-distance: 0%;
      transform: scale(1);
    }
    10% {
      transform: scale(1.2); /* Pulse effect while moving */
    }
    20% {
      transform: scale(1);
    }
    100% {
      offset-distance: 100%;
      transform: scale(1);
    }
  }

  /* Continuous Animations for STEAM elements */
  .spin-element {
    animation: spin 20s linear infinite;
  }
  .spin-element-reverse {
    animation: spinReverse 15s linear infinite;
  }
  
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes spinReverse {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }
  
  /* Firefox fallback for offset-path if needed */
  @supports not (offset-path: none) {
    .adventure-character {
      display: none;
    }
  }
</style>
