---
import { buttonVariants } from '../components/ui/button';
import { cn } from '../lib/utils';
import { EXTERNAL_LINKS } from '../data/constants';

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path);
const programActive = ['/preschool', '/preschool-hbl', '/elementary', '/program'].some(isCurrent);

const primaryNav = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Tentang' },
];

const programNav = [
  { href: '/preschool', label: 'Preschool', desc: 'Holistik berbasis fitrah' },
  { href: '/preschool-hbl', label: 'Preschool HBL', desc: 'Home-Based Learning' },
  { href: '/elementary', label: 'Elementary School', desc: 'Pendidikan dasar Islam (PKBM Setara SD)' },
];

const secondaryNav = [
  { href: '/pendidikan', label: 'Pendidikan' },
  { href: '/kehidupan-sekolah', label: 'Kehidupan Sekolah' },
  { href: '/faq', label: 'FAQ' },
  { href: '/kontak', label: 'Kontak' },
];
---

<header id="main-header" class="site-header" data-menu-open="false">
  <div class="site-header__utility">
    <span>Sekolah Islam Berbasis Fitrah di Bandung</span>
    <div class="flex items-center gap-5">
      <a href="tel:+6285173396002" class="hover:underline">+62 851-7339-6002</a>
      <a href={`${EXTERNAL_LINKS.hub}`} target="_blank" rel="noopener noreferrer" class="hover:underline">Portal TSLS Hub</a>
    </div>
  </div>
  <div class="site-header__inner">
    <a href="/" class="flex items-center shrink-0" aria-label="Tarbiyah Sunnah Lab School — Beranda">
      <img src="/images/logo.svg" alt="Tarbiyah Sunnah Lab School" class="h-10 lg:h-12 w-auto object-contain" width="240" height="54" />
    </a>
    <nav class="site-nav" aria-label="Navigasi utama">
      {primaryNav.map((link) => (
        <a class="site-nav__link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
      <details data-active={programActive ? 'true' : 'false'}>
        <summary>Program <span class="material-symbols-outlined text-base" aria-hidden="true">expand_more</span></summary>
        <div class="site-nav__dropdown">
          {programNav.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              <div class="font-bold text-sm">{link.label}</div>
              <div class="text-xs text-muted-foreground">{link.desc}</div>
            </a>
          ))}
        </div>
      </details>
      {secondaryNav.map((link) => (
        <a class="site-nav__link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="site-header__actions flex items-center gap-2">
      <a href={EXTERNAL_LINKS.spmb} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: 'sm' })}>Daftar SPMB</a>
    </div>
    <button id="mobile-menu-btn" class="site-header__menu-button inline-flex size-11 items-center justify-center rounded-full border border-outline-variant bg-background text-primary" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu">
      <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-nav" data-open="false" aria-hidden="true">
  <nav class="mobile-nav__group" aria-label="Navigasi seluler">
    <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Beranda <span aria-hidden="true">→</span></a>
    <a href="/tentang" aria-current={isCurrent('/tentang') ? 'page' : undefined}>Tentang <span aria-hidden="true">→</span></a>
    <a href="/preschool" aria-current={isCurrent('/preschool') ? 'page' : undefined}>Preschool <span aria-hidden="true">→</span></a>
    <a href="/preschool-hbl" aria-current={isCurrent('/preschool-hbl') ? 'page' : undefined}>Preschool HBL <span aria-hidden="true">→</span></a>
    <a href="/elementary" aria-current={isCurrent('/elementary') ? 'page' : undefined}>Elementary School <span aria-hidden="true">→</span></a>
    <a href="/pendidikan" aria-current={isCurrent('/pendidikan') ? 'page' : undefined}>Pendidikan <span aria-hidden="true">→</span></a>
    <a href="/kehidupan-sekolah" aria-current={isCurrent('/kehidupan-sekolah') ? 'page' : undefined}>Kehidupan Sekolah <span aria-hidden="true">→</span></a>
    <a href="/faq" aria-current={isCurrent('/faq') ? 'page' : undefined}>FAQ <span aria-hidden="true">→</span></a>
    <a href="/kontak" aria-current={isCurrent('/kontak') ? 'page' : undefined}>Kontak <span aria-hidden="true">→</span></a>
    <div class="grid gap-3 pt-5">
      <a href={EXTERNAL_LINKS.spmb} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ size: 'lg' }), 'justify-center border-0 text-base')}>Daftar SPMB</a>
      <a href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'justify-center text-base')}>Portal Orang Tua</a>
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById('main-header');
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = button?.querySelector('.material-symbols-outlined');
  const setMenu = (open: boolean) => {
    header?.setAttribute('data-menu-open', String(open));
    menu?.setAttribute('data-open', String(open));
    menu?.setAttribute('aria-hidden', String(!open));
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    if (icon) icon.textContent = open ? 'close' : 'menu';
    document.body.style.overflow = open ? 'hidden' : '';
  };
  const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });
  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenu(false);
      button?.focus();
    }
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setMenu(false);
  });

  // Close desktop details dropdown when clicking outside
  document.addEventListener('click', (event) => {
    const details = document.querySelector('.site-nav details');
    if (details && details.hasAttribute('open') && !details.contains(event.target as Node)) {
      details.removeAttribute('open');
    }
  });
</script>
