---
import { buttonVariants } from '../components/ui/button';
import { cn } from '../lib/utils';

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path);
const programActive = ['/program', '/preschool', '/elementary', '/fasilitas'].some(isCurrent);
const primaryLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/profil', label: 'Profil' },
  { href: '/faq', label: 'FAQ' },
  { href: '/kontak', label: 'Kontak' },
];
const programLinks = [
  { href: '/program', label: 'Semua Program' },
  { href: '/preschool', label: 'Preschool' },
  { href: '/elementary', label: 'Elementary' },
  { href: '/fasilitas', label: 'Fasilitas' },
];
---

<header id="main-header" class="site-header" data-menu-open="false">
  <div class="site-header__utility">
    <span>Sekolah Islam di Bandung</span>
    <div class="flex items-center gap-5">
      <a href="tel:+6285173396002">+62 851-7339-6002</a>
      <a href="https://hub.tslabschool.sch.id/portal/login" target="_blank" rel="noopener noreferrer">Portal Orang Tua</a>
    </div>
  </div>
  <div class="site-header__inner">
    <a href="/" class="flex items-center shrink-0" aria-label="TS Lab School — Beranda">
      <img src="/images/logo.png" alt="" class="h-11 lg:h-14 w-auto object-contain" width="184" height="64" />
    </a>
    <nav class="site-nav" aria-label="Navigasi utama">
      {primaryLinks.slice(0, 2).map((link) => <a class="site-nav__link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
      <details data-active={programActive ? 'true' : 'false'}>
        <summary>Program <span class="material-symbols-outlined text-base" aria-hidden="true">expand_more</span></summary>
        <div class="site-nav__dropdown">
          {programLinks.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
        </div>
      </details>
      {primaryLinks.slice(2).map((link) => <a class="site-nav__link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="site-header__actions flex items-center gap-2">
      <a href="https://hub.tslabschool.sch.id/spmb/login" target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: 'sm' })}>Daftar SPMB</a>
    </div>
    <button id="mobile-menu-btn" class="site-header__menu-button inline-flex size-11 items-center justify-center rounded-full border border-outline-variant bg-background text-primary" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Buka menu">
      <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-nav" data-open="false" aria-hidden="true">
  <nav class="mobile-nav__group" aria-label="Navigasi seluler">
    <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Beranda <span aria-hidden="true">→</span></a>
    <a href="/profil" aria-current={isCurrent('/profil') ? 'page' : undefined}>Profil <span aria-hidden="true">→</span></a>
    <a href="/program" aria-current={isCurrent('/program') ? 'page' : undefined}>Semua Program <span aria-hidden="true">→</span></a>
    <a href="/preschool" aria-current={isCurrent('/preschool') ? 'page' : undefined}>Preschool <span aria-hidden="true">→</span></a>
    <a href="/elementary" aria-current={isCurrent('/elementary') ? 'page' : undefined}>Elementary <span aria-hidden="true">→</span></a>
    <a href="/fasilitas" aria-current={isCurrent('/fasilitas') ? 'page' : undefined}>Fasilitas <span aria-hidden="true">→</span></a>
    <a href="/faq" aria-current={isCurrent('/faq') ? 'page' : undefined}>FAQ <span aria-hidden="true">→</span></a>
    <a href="/kontak" aria-current={isCurrent('/kontak') ? 'page' : undefined}>Kontak <span aria-hidden="true">→</span></a>
    <div class="grid gap-3 pt-5">
      <a href="https://hub.tslabschool.sch.id/spmb/login" target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ size: 'lg' }), 'justify-center border-0 text-base')}>Daftar SPMB</a>
      <a href="https://hub.tslabschool.sch.id/portal/login" target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'justify-center text-base')}>Portal Orang Tua</a>
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById('main-header');
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = button?.querySelector('.material-symbols-outlined');
  const setMenu = (open: boolean) => {
    header?.setAttribute('data-menu-open', String(open));
    menu?.setAttribute('data-open', String(open));
    menu?.setAttribute('aria-hidden', String(!open));
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    if (icon) icon.textContent = open ? 'close' : 'menu';
    document.body.style.overflow = open ? 'hidden' : '';
  };
  const syncHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });
  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenu(false);
      button?.focus();
    }
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setMenu(false);
  });
</script>
