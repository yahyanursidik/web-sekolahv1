---
import { EXTERNAL_LINKS, PRIMARY_NAV, SITE, SPMB, UTILITY_NAV } from '../data/constants';
import { PROGRAMS } from '../data/programs';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
const programActive = currentPath === '/program' || currentPath.startsWith('/program/');
---

<div class="topbar">
  <div class="container topbar__inner">
    <span>{SITE.city} · Pendidikan Islam sesuai fitrah</span>
    <div class="topbar__links">
      <a href={EXTERNAL_LINKS.consultation} target="_blank" rel="noopener">WhatsApp School Center</a>
      <a href={EXTERNAL_LINKS.portal} target="_blank" rel="noopener">Portal Orang Tua ↗</a>
    </div>
  </div>
</div>

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} — Beranda`}>
      <img
        class="brand__mark"
        src="/images/logo-mark.png"
        alt=""
        width="578"
        height="300"
        fetchpriority="high"
      />
      <span class="brand__text">
        <span class="brand__name">Sekolah Tarbiyah<br />Sunnah Bandung</span>
        <span class="brand__tagline">MOVE. LEARN. GROW.</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navigasi utama">
      <a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Beranda</a>
      <button
        id="program-toggle"
        type="button"
        class={programActive ? 'is-active' : undefined}
        aria-haspopup="true"
        aria-controls="program-mega"
        aria-expanded="false"
      >
        Program <span class="nav__caret" aria-hidden="true">⌄</span>
      </button>
      {
        PRIMARY_NAV.filter((item) => item.href !== '/').map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <a class="header-link" href={EXTERNAL_LINKS.hub} target="_blank" rel="noopener">TSLS Hub ↗</a>
      <a class="btn btn--primary btn--small" href="/spmb">
        {SPMB.label} <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
      <button
        class="burger"
        id="burger"
        type="button"
        aria-label="Buka menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        ☰
      </button>
    </div>
  </div>

  <div class="megawrap" id="program-mega">
    <div class="mega">
      <div class="mega__lead">
        <span class="eyebrow">Pilihan program</span>
        <strong>Satu fondasi.<br />Tiga perjalanan.</strong>
        <p>Temukan pola belajar sesuai tahap Ananda dan kebutuhan keluarga.</p>
      </div>
      {
        PROGRAMS.map((program, index) => (
          <a class="mega__item" href={`/program/${program.slug}`}>
            <small>
              {String(index + 1).padStart(2, '0')} · {program.modalityShort} · {program.ageRange.replace('Usia ', '')}
            </small>
            <strong>{program.name}</strong>
            <p>{program.cardSummary}</p>
          </a>
        ))
      }
    </div>
  </div>
</header>

<div class="drawer-shade" id="mobile-drawer" aria-hidden="true">
  <aside class="drawer" aria-label="Menu navigasi">
    <div class="drawer__top">
      <span class="brand">
        <img class="brand__mark" src="/images/logo-mark.png" alt="" width="578" height="300" />
        <span class="brand__text">
          <span class="brand__name">Sekolah Tarbiyah<br />Sunnah Bandung</span>
          <span class="brand__tagline">MOVE. LEARN. GROW.</span>
        </span>
      </span>
      <button class="drawer__close" id="drawer-close" type="button" aria-label="Tutup menu">×</button>
    </div>

    <a class="drawer__link" href="/">Beranda <span aria-hidden="true">↗</span></a>
    <a class="drawer__link" href="/program">Semua Program <span aria-hidden="true">↗</span></a>
    <div class="drawer__sub">
      {PROGRAMS.map((program) => <a href={`/program/${program.slug}`}>{program.shortName}</a>)}
    </div>
    {
      PRIMARY_NAV.filter((item) => item.href !== '/').map((item) => (
        <a class="drawer__link" href={item.href}>
          {item.label} <span aria-hidden="true">↗</span>
        </a>
      ))
    }
    {
      UTILITY_NAV.map((item) => (
        <a class="drawer__link" href={item.href}>
          {item.label} <span aria-hidden="true">↗</span>
        </a>
      ))
    }

    <div class="drawer__cta">
      <a class="btn btn--primary" href="/spmb">Informasi {SPMB.label} ↗</a>
      <a class="btn btn--light" href={EXTERNAL_LINKS.portal} target="_blank" rel="noopener">
        Portal Orang Tua ↗
      </a>
    </div>
  </aside>
</div>

<script>
  const mega = document.getElementById('program-mega');
  const toggle = document.getElementById('program-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const burger = document.getElementById('burger');
  const drawerClose = document.getElementById('drawer-close');

  const closeMega = () => {
    mega?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  const closeDrawer = () => {
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    burger?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('is-menu-open');
  };

  const closeAll = () => {
    closeMega();
    closeDrawer();
  };

  toggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
    closeAll();
    if (!wasOpen) {
      mega?.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
    }
  });

  burger?.addEventListener('click', () => {
    closeAll();
    drawer?.classList.add('is-open');
    drawer?.setAttribute('aria-hidden', 'false');
    burger.setAttribute('aria-expanded', 'true');
    document.body.classList.add('is-menu-open');
    (drawer?.querySelector('.drawer__close') as HTMLElement | null)?.focus();
  });

  drawerClose?.addEventListener('click', () => {
    closeDrawer();
    burger?.focus();
  });

  drawer?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === drawer || target.closest('a')) closeDrawer();
  });

  mega?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMega();
  });

  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('.site-header')) closeMega();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const drawerWasOpen = drawer?.classList.contains('is-open');
    const megaWasOpen = mega?.classList.contains('is-open');
    closeAll();
    if (drawerWasOpen) burger?.focus();
    else if (megaWasOpen) toggle?.focus();
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 920) closeDrawer();
  });
</script>
