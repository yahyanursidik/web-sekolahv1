---
import type { Program } from '../../data/programs';

interface Props {
  program: Program;
}

const { program } = Astro.props;
const tones: Record<string, string> = {
  'preschool-reguler': '#d7e7cb',
  'preschool-hbl': '#cbe2e4',
  elementary: '#e8dfce',
};
const tone = tones[program.slug] ?? '#d7e7cb';
---

<a class="program-card" href={`/program/${program.slug}`}>
  <div class="program-card__art" style={`background:${tone}`}>
    {
      program.cardImage && (
        <img loading="lazy" src={program.cardImage} alt={program.imageAlt} width="520" height="360" />
      )
    }
    <span class="program-card__tag">{program.cardTag}</span>
  </div>
  <div class="program-card__body">
    <h3>{program.name}</h3>
    <p>{program.cardSummary}</p>
    <div class="program-card__meta">
      <span>{program.ageRange}</span>
      <span>{program.modalityShort}</span>
    </div>
    <span class="program-card__link">
      Kenali program <span class="btn__arrow" aria-hidden="true">↗</span>
    </span>
  </div>
</a>
